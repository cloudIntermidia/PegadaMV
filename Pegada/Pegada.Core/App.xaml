            <DataTemplate x:Key="CatalogoTemplate">
                <StackLayout HeightRequest="190"
                             BackgroundColor="Silver">
                    <Grid BackgroundColor="White"
                          RowSpacing="3"
                          Margin="1"
                          HorizontalOptions="FillAndExpand"
                          VerticalOptions="FillAndExpand"
                      >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" RowSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="0,0,3,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                               <RowDefinition Height="*"/>
                               <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ffimageloading:CachedImage Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" DownsampleToViewSize="False" Source="{Binding ExibeEtiquetaPromocao, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',etiqueta_promocao.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="25" WidthRequest="25" Margin="10,0" />

                            <ffimageloading:CachedImage Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" DownsampleToViewSize="False" Source="{Binding ExibeSetaBaixoVermelha, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',seta_baixo_vermelha.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="15" WidthRequest="15" Margin="10,0" />

                            <!-- PREÇO DE -->
                                <Label Grid.Row="0"
                                       Grid.Column="2"
                                       IsVisible="{Binding IndPromocional}"
                                       Text="{Binding PrecoDe, Converter={StaticResource ValorParaMoeda}}"
                                       FontSize="10"
                                       FontFamily="{StaticResource RobotoBoldFont}"
                                       TextColor="LightGray"
                                       TextDecorations="Strikethrough"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center"/>

                                <!-- PREÇO POR / PREÇO NORMAL -->
                               <Label Grid.Row="0"
                                       Grid.Column="3"
                                       Text="{Binding PrecoPor, Converter={StaticResource ValorParaMoeda}}"
                                       FontSize="11"
                                       HorizontalOptions="EndAndExpand"
                                       VerticalOptions="Center">

                                    <Label.Triggers>

                                        <!-- PROMOCIONAL -->
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IndPromocional}"
                                                     Value="1">

                                            <Setter Property="TextColor"
                                                    Value="#006633"/>

                                            <Setter Property="FontFamily"
                                                    Value="{StaticResource RobotoBoldFont}"/>

                                        </DataTrigger>

                                        <!-- NORMAL -->
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IndPromocional}"
                                                     Value="0">

                                            <Setter Property="TextColor"
                                                    Value="Black"/>

                                            <Setter Property="FontFamily"
                                                    Value="{StaticResource RobotoNormalFont}"/>

                                        </DataTrigger>

                                    </Label.Triggers>

                                </Label>

                            <!-- PREÇO PVL -->
                                <Label Grid.Row="1"
                                       Grid.Column="3"
                                       IsVisible="{Binding IsMostraPreco}"
                                       Text="{Binding PrecoPVL, Converter={StaticResource ValorPVLParaMoeda}}"
                                       FontSize="11"
                                       FontFamily="{StaticResource RobotoNormalFont}"
                                       HorizontalOptions="EndAndExpand"/>

                            <!--PRECO DE-->
                            <!--<Label IsVisible="{Binding IsMostraPreco}" Grid.Row="0" Grid.Column="2" HorizontalTextAlignment="Center" Text="{Binding PrecoOriginal, Converter={StaticResource ValorParaMoeda}}" FontSize="13" FontFamily="{StaticResource RobotoNormalFont}" HorizontalOptions="End"/>-->
                            <!--PRECO POR ou preço normal-->
                            <!--<Label IsVisible="{Binding IsMostraPreco}" Grid.Row="0" Grid.Column="3" HorizontalTextAlignment="Center" Text="{Binding PrecoVenda, Converter={StaticResource ValorParaMoeda}}" FontSize="13" FontFamily="{StaticResource RobotoNormalFont}" HorizontalOptions="EndAndExpand"/>-->
                            <!--PRECO PVL-->
                            <!--<Label IsVisible="{Binding IsMostraPreco}" Grid.Row="1" Grid.Column="3" HorizontalTextAlignment="Center" Text="{Binding PrecoPVL, Converter={StaticResource ValorPVLParaMoeda}}" FontSize="13" FontFamily="{StaticResource RobotoNormalFont}" HorizontalOptions="EndAndExpand"/>-->


                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0" BackgroundColor="White" RowSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <!--<Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>-->


                            <ffimageloading:CachedImage Grid.Row="0" Grid.Column="0" DownsampleToViewSize="False" Source="{Binding ExibeTrofeu, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',trofeu.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="25" WidthRequest="25" Margin="10,0" />

                            <ffimageloading:CachedImage Grid.Row="1" Grid.Column="0" DownsampleToViewSize="False" Source="{Binding ExibeTV, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',tv.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="25" WidthRequest="25" Margin="10,0" />

                            <ffimageloading:CachedImage Grid.Row="2" Grid.Column="0" DownsampleToViewSize="False" Source="{Binding ExibeNew, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',new.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="25" WidthRequest="25" Margin="10,0" />

                            <ffimageloading:CachedImage 
                                                Grid.Row="3" Grid.Column="0"
                                                DownsampleToViewSize="False" 
                                                Source="{Binding ItemChecado, Converter={StaticResource BoleanoParaImagem}, ConverterParameter='wish_unchecked.png,wish_checked.png'}" 
                                                LoadingPlaceholder="NaoDisp.png"
                                                Aspect="AspectFit" 
                                                HorizontalOptions="End"
                                                HeightRequest="35"
                                                WidthRequest="35"
                                                Margin="10,0"
                                                >
                                <ffimageloading:CachedImage.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AdicionarItemCommand}" 
                                                  CommandParameter="{Binding .}"/>
                                </ffimageloading:CachedImage.GestureRecognizers>
                            </ffimageloading:CachedImage>

                            <!--<ffimageloading:CachedImage Grid.Row="3" Grid.Column="0" DownsampleToViewSize="False" Source="{Binding ExibeEstrela, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',estrela_inativa.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="25" WidthRequest="25" Margin="10,0" />-->

                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="2" BackgroundColor="White" RowSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <!--<Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>-->

                             <ffimageloading:CachedImage Grid.Row="0" Grid.Column="0" DownsampleToViewSize="False" Source="{Binding ExibeEstoqueAvulso, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',e_a.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="40" WidthRequest="40" Margin="5,0">
                                    <ffimageloading:CachedImage.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DirecionarB2bCommand}"
                                                          CommandParameter="{Binding .}"/>
                                    </ffimageloading:CachedImage.GestureRecognizers>
                                </ffimageloading:CachedImage>

                            <StackLayout Grid.Row="1" Grid.Column="0" Orientation="Vertical" Spacing="0" IsVisible="{Binding ExibeProntaEntrega}">
                                <!--<ffimageloading:CachedImage  DownsampleToViewSize="False" Source="{Binding ExibeProntaEntrega, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',pronta_entrega.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="40" WidthRequest="40" Margin="10,0" />-->

                                <!--<ffimageloading:CachedImage  DownsampleToViewSize="False" Source="{Binding ExibeProntaEntrega, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',pronta_entrega.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="40" WidthRequest="40" Margin="10,0" >
                                    <ffimageloading:CachedImage.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DirecionarProntaEntregaCommand}" 
                                                  CommandParameter="{Binding .}"/>
                                    </ffimageloading:CachedImage.GestureRecognizers>
                                </ffimageloading:CachedImage>-->

                                <ffimageloading:CachedImage DownsampleToViewSize="False" Source="{Binding ExibeProntaEntrega, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',pronta_entrega.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="40" WidthRequest="40" Margin="5,0">
                                    <ffimageloading:CachedImage.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DirecionarProntaEntregaCommand}"
                                                          CommandParameter="{Binding .}"/>
                                    </ffimageloading:CachedImage.GestureRecognizers>
                                </ffimageloading:CachedImage>

                                <Label IsVisible="{Binding MostraQtdEstoque}" Margin="0,-10,0,0" HorizontalTextAlignment="Center" Text="{Binding Estoque}" FontSize="8" FontFamily="{StaticResource RobotoNormalFont}" HeightRequest="12"/>
                            </StackLayout>
                            

                             <StackLayout Grid.Row="2" Grid.Column="0" Orientation="Vertical" Spacing="0" IsVisible="{Binding ExibeCaixaAzul}">

                                 <ffimageloading:CachedImage DownsampleToViewSize="False" Source="{Binding ExibeCaixaAzul, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',caixa_azul.jpeg'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="40" WidthRequest="40" Margin="10,0">
                                    <ffimageloading:CachedImage.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DirecionarB2bCommand}"
                                                          CommandParameter="{Binding .}"/>
                                    </ffimageloading:CachedImage.GestureRecognizers>
                                </ffimageloading:CachedImage>

                                <Label Margin="0,-4,0,0" HorizontalTextAlignment="Center" Text="{Binding EstoqueFuturo}" FontSize="8" FontFamily="{StaticResource RobotoNormalFont}" HeightRequest="12"/>
                            </StackLayout>

                            <ffimageloading:CachedImage Grid.Row="3" Grid.Column="0" DownsampleToViewSize="False" Source="{Binding ExibeForaLinha, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',fora_linha.png'}" 
                                LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" HorizontalOptions="End" HeightRequest="35" WidthRequest="35" Margin="10,0" />



                        </Grid>

                        <ffimageloading:CachedImage Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" DownsampleToViewSize="False" Source="{Binding Imagem, Converter={StaticResource Base64ParaImagem}}" 
                            LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" />


                        <Label IsVisible="{Binding MostraSigla}" Grid.Row="2" Grid.Column="0" Margin="3,0,3,0" HorizontalTextAlignment="Center" Text="{Binding Sigla}" FontSize="10" FontFamily="{StaticResource RobotoNormalFont}" />
                        <Label Grid.Row="2" Grid.Column="1" Margin="3,0,3,0" HorizontalTextAlignment="Center" Text="{Binding Descricao}" FontSize="9" FontFamily="{StaticResource RobotoNormalFont}" />

                        <!--<Label Grid.Row="3" Grid.Column="1" Margin="3,0,3,0" HorizontalTextAlignment="Center" Text="{Binding DescricaoProdutoModelo}" FontSize="9" FontFamily="{StaticResource RobotoNormalFont}" />-->

                    </Grid>
                </StackLayout>
            </DataTemplate>


            <DataTemplate x:Key="ListaTemplate">
                <StackLayout Spacing="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <Label Style="{StaticResource labelGridItem}" Text="{Binding CodModelo}"  Grid.Row="0" Grid.Column="0"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding Descricao}"  Grid.Row="0" Grid.Column="1"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding DescricaoCor}"  Grid.Row="0" Grid.Column="2"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding Estoque}"  Grid.Row="0" Grid.Column="3"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding DataEntrega}"  Grid.Row="0" Grid.Column="4"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding Origem}"  Grid.Row="0" Grid.Column="5"/>
                        <StackLayout Grid.Row="0"
                                 Grid.Column="6"
                                 HorizontalOptions="Start"
                                 Spacing="0"
                                 >

                            <ffimageloading:CachedImage 
                                                DownsampleToViewSize="True"
                                                BackgroundColor="Transparent"
                                                Source="{Binding ItemEPromocao, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',promocao.png'}" 
                                                HorizontalOptions="End"
                                                VerticalOptions="Center"
                                                HeightRequest="20"
                                                Margin="3,0,0,0"
                                                Aspect="AspectFit">
                            </ffimageloading:CachedImage>

                            <ffimageloading:CachedImage 
                                                DownsampleToViewSize="True"
                                                BackgroundColor="Transparent"
                                                Source="{Binding ItemEProntaEntrega, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',pe.png'}" 
                                                HorizontalOptions="End"
                                                VerticalOptions="Center"
                                                HeightRequest="20"
                                                Margin="3,0,0,0"
                                                Aspect="AspectFit">
                            </ffimageloading:CachedImage>
                        </StackLayout>

                    </Grid>

                    <BoxView HeightRequest="1.5" Color="Silver" HorizontalOptions="FillAndExpand"/>
                </StackLayout>
            </DataTemplate>

            <DataTemplate x:Key="HeaderListaTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Style="{StaticResource labelGridHeader}" Text="Código"  Grid.Row="0" Grid.Column="0"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Modelo"  Grid.Row="0" Grid.Column="1"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Cor"  Grid.Row="0" Grid.Column="2"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Qtd. Disponível"  Grid.Row="0" Grid.Column="3"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Data de Entrega"  Grid.Row="0" Grid.Column="4"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Org. Estoque"  Grid.Row="0" Grid.Column="5"/>
                        <Label Style="{StaticResource labelGridHeader}" Text=""  Grid.Row="0" Grid.Column="6"/>

                    </Grid>
            </DataTemplate>



            <dataTemplate:ModeloTemplateSelector x:Key="ModeloTemplateSelector"
                                             CatalogoTemplate="{StaticResource CatalogoTemplate}"
                                             ListaTemplate="{StaticResource ListaTemplate}"
                                             />

            <dataTemplate:HeaderModeloTemplateSelector x:Key="HeaderModeloTemplateSelector"
                                                       HeaderListaTemplate="{StaticResource HeaderListaTemplate}"/>

            <DataTemplate x:Key="ClienteSelecaoTemplate">
                <ViewCell>
                    <StackLayout>
                        <Grid Margin="5"
                              RowSpacing="2"
                              ColumnSpacing="5"
                              HeightRequest="50">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <!-- LINHA 1 -->
                            <StackLayout Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                                <Label 
                                   Text="{Binding RazaoSocial}"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   FontAttributes="Bold"/>

                                <Label 
                                   Text="-"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   FontAttributes="Bold"/>

                                <Label 
                                   Text="{Binding CNPJ}"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   FontAttributes="Bold"/>
                            </StackLayout>
                            

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CodPessoaCliente}"
                                   FontSize="13"
                                   HorizontalOptions="End"/>

                            <ffimageloading:CachedImage Grid.Row="0"
                                                         Grid.Column="2"
                                                         HeightRequest="20"
                                                         WidthRequest="20"
                                                         Source="info.png"
                                                         HorizontalOptions="End"
                                                         VerticalOptions="Center">
                                <ffimageloading:CachedImage.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding InfoCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </ffimageloading:CachedImage.GestureRecognizers>
                            </ffimageloading:CachedImage>

                              <!-- LINHA 2 -->
                              <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding NomeFantasia}"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   FontAttributes="Bold"/>


                            <!-- LINHA 3 -->
                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding EnderecoPrincipalCompleto}"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"/>

                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Cidade}"
                                   FontSize="12"
                                   HorizontalOptions="End"/>

                            <Label Grid.Row="2" Grid.Column="2"
                                   Text="{Binding UF}"
                                   FontSize="12"
                                   HorizontalOptions="End"/>
                        </Grid>

                        <BoxView  HeightRequest="0.5" 
                                  HorizontalOptions="FillAndExpand"
                                  Color="Black"/>

                        <StackLayout.Triggers>
                            <DataTrigger TargetType="StackLayout"
                                         Binding="{Binding CodSituacaoCliente}" 
                                         Value="2">

                                <Setter Property="BackgroundColor" Value="Red"/>
                            </DataTrigger>
                        </StackLayout.Triggers>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>


        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>