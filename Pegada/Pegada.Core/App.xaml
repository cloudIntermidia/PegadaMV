            <!-- Célula do catálogo = célula ItemCatalogoCell (255x184) do ItemCatalogoCollectionViewController do PegadaIOS:
                 cada elemento no frame do storyboard, os da esquerda presos à esquerda (Margin = x,y) e os da direita presos
                 à direita (Margin direita = 255 - x - largura), pra não derivarem quando a célula é mais larga que 255.
                 Foto aberta já reduzida (em pixels de tela): no tamanho original (até 1500x1500) cada célula ocupava de 2 a 9 MB
                 e a navegação entre modelos estourava a memória. -->
            <DataTemplate x:Key="CatalogoTemplate">
                <StackLayout HeightRequest="190"
                             BackgroundColor="Silver">
                    <Grid BackgroundColor="White"
                          Margin="1"
                          HorizontalOptions="FillAndExpand"
                          VerticalOptions="FillAndExpand">

                        <!-- imageView (28,23,188,121) - declarada primeiro pra ficar por baixo dos ícones -->
                        <ffimageloading:CachedImage Margin="28,23,39,40" InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill" DownsampleHeight="170" DownsampleUseDipUnits="True" Source="{Binding Imagem, Converter={StaticResource Base64ParaImagem}}"
                            LoadingPlaceholder="NaoDisp.png" Aspect="AspectFit" />

                        <!-- iconPromo (8,2,26,26) -->
                        <ffimageloading:CachedImage Margin="8,2,0,0" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="26" HeightRequest="26" DownsampleToViewSize="False" Aspect="AspectFit"
                            Source="{Binding ExibeEtiquetaPromocao, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',etiqueta_promocao.png'}" />

                        <!-- iconDesconto (45,0,33,30) -->
                        <ffimageloading:CachedImage Margin="45,0,0,0" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="33" HeightRequest="30" DownsampleToViewSize="False" Aspect="AspectFit"
                            Source="{Binding ExibeSetaBaixoVermelha, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',seta_baixo_vermelha.png'}" />

                        <!-- carrinhoIcon (93,0,24,24) -->
                        <Image Margin="93,0,0,0" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" Source="carrinho.png"
                               IsVisible="{Binding ExibeCarrinho, Converter={StaticResource IntToBoolConverter}}" />

                        <!-- iconCampeaoVenda (8,30,26,26) -->
                        <ffimageloading:CachedImage Margin="8,30,0,0" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="26" HeightRequest="26" DownsampleToViewSize="False" Aspect="AspectFit"
                            Source="{Binding ExibeTrofeu, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',trofeu.png'}" />

                        <!-- iconMid (13,65,16,16) -->
                        <ffimageloading:CachedImage Margin="13,65,0,0" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="16" HeightRequest="16" DownsampleToViewSize="False" Aspect="AspectFit"
                            Source="{Binding ExibeTV, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',tv.png'}" />

                        <!-- iconNov (8,83,24,24) -->
                        <ffimageloading:CachedImage Margin="8,83,0,0" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="24" HeightRequest="24" DownsampleToViewSize="False" Aspect="AspectFit"
                            Source="{Binding ExibeNew, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',new.png'}" />

                        <!-- btnFavorito (8,120,25,25) -->
                        <ffimageloading:CachedImage Margin="8,120,0,0" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="25" HeightRequest="25" DownsampleToViewSize="False" Aspect="AspectFit"
                            Source="{Binding ItemChecado, Converter={StaticResource BoleanoParaImagem}, ConverterParameter='wish_unchecked.png,wish_checked.png'}">
                            <ffimageloading:CachedImage.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AdicionarItemCommand}" CommandParameter="{Binding .}"/>
                            </ffimageloading:CachedImage.GestureRecognizers>
                        </ffimageloading:CachedImage>

                        <!-- siglaLbl (4,148,40,17) -->
                        <Label IsVisible="{Binding MostraSigla}" Margin="4,148,0,0" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="40" HeightRequest="17" Text="{Binding Sigla}" FontSize="12" FontFamily="{StaticResource RobotoNormalFont}" />

                        <!-- precoDe (80,6,76,16) - botão de preço (cifrão) desligado esconde o "De" mesmo em promoção -->
                        <Label Margin="0,6,99,0" HorizontalOptions="End" VerticalOptions="Start" HeightRequest="16" VerticalTextAlignment="Center"
                               IsVisible="{Binding IndPromocional}" Text="{Binding PrecoDeUI, StringFormat='De: {0}'}"
                               FontSize="10" FontFamily="{StaticResource RobotoBoldFont}" TextColor="LightGray" TextDecorations="Strikethrough">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsMostraPreco}" Value="False">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <!-- priceLabel (164,0,80,16) - preço Por (promocional) ou preço normal -->
                        <Label Margin="0,0,11,0" HorizontalOptions="End" VerticalOptions="Start" HeightRequest="16" VerticalTextAlignment="Center" HorizontalTextAlignment="End"
                               IsVisible="{Binding IsMostraPreco}" Text="{Binding PrecoPorUI}" FontSize="11">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IndPromocional}" Value="1">
                                    <Setter Property="Text" Value="{Binding PrecoPorUI, StringFormat='Por: {0}'}"/>
                                    <Setter Property="TextColor" Value="#006633"/>
                                    <Setter Property="FontFamily" Value="{StaticResource RobotoBoldFont}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IndPromocional}" Value="0">
                                    <Setter Property="TextColor" Value="Black"/>
                                    <Setter Property="FontFamily" Value="{StaticResource RobotoNormalFont}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <!-- precoPVL (164,12,80,16) -->
                        <Label Margin="0,12,11,0" HorizontalOptions="End" VerticalOptions="Start" HeightRequest="16" VerticalTextAlignment="Center" HorizontalTextAlignment="End"
                               IsVisible="{Binding IsMostraPreco}" Text="{Binding PrecoPVL, Converter={StaticResource ValorPVLParaMoeda}}"
                               FontSize="11" FontFamily="{StaticResource RobotoNormalFont}" />

                        <!-- iconEstoqueAvulso (190,33,25,25) -->
                        <ffimageloading:CachedImage Margin="0,33,40,0" HorizontalOptions="End" VerticalOptions="Start" WidthRequest="25" HeightRequest="25" DownsampleToViewSize="False" Aspect="AspectFit"
                            Source="{Binding ExibeEstoqueAvulso, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',e_a.png'}">
                            <ffimageloading:CachedImage.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DirecionarB2bCommand}" CommandParameter="{Binding .}"/>
                            </ffimageloading:CachedImage.GestureRecognizers>
                        </ffimageloading:CachedImage>

                        <!-- btnPE (220,33,32,32) + estoqueLbl (215,56,35,19) -->
                        <ffimageloading:CachedImage Margin="0,33,3,0" HorizontalOptions="End" VerticalOptions="Start" WidthRequest="32" HeightRequest="32" DownsampleToViewSize="False" Aspect="AspectFit"
                            IsVisible="{Binding ExibeProntaEntrega, Converter={StaticResource IntToBoolConverter}}"
                            Source="{Binding ExibeProntaEntrega, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',pronta_entrega.png'}">
                            <ffimageloading:CachedImage.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DirecionarProntaEntregaCommand}" CommandParameter="{Binding .}"/>
                            </ffimageloading:CachedImage.GestureRecognizers>
                        </ffimageloading:CachedImage>
                        <ContentView Margin="0,56,5,0" HorizontalOptions="End" VerticalOptions="Start" WidthRequest="35" HeightRequest="19" InputTransparent="True"
                                     IsVisible="{Binding ExibeProntaEntrega, Converter={StaticResource IntToBoolConverter}}">
                            <Label IsVisible="{Binding MostraQtdEstoque}" HorizontalTextAlignment="End" VerticalTextAlignment="Center" Text="{Binding Estoque}" FontSize="9" FontFamily="{StaticResource RobotoNormalFont}" />
                        </ContentView>

                        <!-- btnSoPe (mesmo frame do btnPE) + quantidade no lugar do estoqueLbl -->
                        <ffimageloading:CachedImage Margin="0,33,3,0" HorizontalOptions="End" VerticalOptions="Start" WidthRequest="32" HeightRequest="32" DownsampleToViewSize="False" Aspect="AspectFit"
                            IsVisible="{Binding IsSoPE}"
                            Source="{Binding IsSoPE, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',SoPE.png'}">
                            <ffimageloading:CachedImage.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DirecionarProntaEntregaCommand}" CommandParameter="{Binding .}"/>
                            </ffimageloading:CachedImage.GestureRecognizers>
                        </ffimageloading:CachedImage>
                        <ContentView Margin="0,56,5,0" HorizontalOptions="End" VerticalOptions="Start" WidthRequest="35" HeightRequest="19" InputTransparent="True"
                                     IsVisible="{Binding IsSoPE}">
                            <Label IsVisible="{Binding MostraQtdEstoque}" HorizontalTextAlignment="End" VerticalTextAlignment="Center" Text="{Binding EstoqueFuturo}" FontSize="9" FontFamily="{StaticResource RobotoNormalFont}" />
                        </ContentView>

                        <!-- iconEstoqueFuturo (225,78,25,25) + estoqueFutLbl (215,104,35,19) - touchEstoqueFuturo do PegadaIOS -->
                        <ffimageloading:CachedImage Margin="0,78,5,0" HorizontalOptions="End" VerticalOptions="Start" WidthRequest="25" HeightRequest="25" DownsampleToViewSize="False" Aspect="AspectFit"
                            IsVisible="{Binding ExibeCaixaAzul, Converter={StaticResource IntToBoolConverter}}"
                            Source="{Binding ExibeCaixaAzul, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',caixa_azul.jpeg'}">
                            <ffimageloading:CachedImage.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DirecionarEstoqueFuturoCommand}" CommandParameter="{Binding .}"/>
                            </ffimageloading:CachedImage.GestureRecognizers>
                        </ffimageloading:CachedImage>
                        <Label Margin="0,104,5,0" HorizontalOptions="End" VerticalOptions="Start" WidthRequest="35" HeightRequest="19" HorizontalTextAlignment="End" VerticalTextAlignment="Center"
                               IsVisible="{Binding ExibeCaixaAzul, Converter={StaticResource IntToBoolConverter}}"
                               Text="{Binding EstoqueFuturo}" FontSize="9" FontFamily="{StaticResource RobotoNormalFont}" />

                        <!-- iconInativo (219,136,35,25) = fora de linha -->
                        <ffimageloading:CachedImage Margin="0,136,1,0" HorizontalOptions="End" VerticalOptions="Start" WidthRequest="35" HeightRequest="25" DownsampleToViewSize="False" Aspect="AspectFit"
                            Source="{Binding ExibeForaLinha, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',fora_linha.png'}" />

                        <!-- "SOMENTE ESTOQUE" (só MV): logo abaixo da foto, acima da descrição -->
                        <Label Margin="0,146,0,0" HorizontalOptions="Center" VerticalOptions="Start" Text="SOMENTE ESTOQUE" IsVisible="{Binding IsSoPE}"
                               TextColor="Black" FontSize="12" FontFamily="{StaticResource RobotoBoldFont}" />

                        <!-- descLabelCompl (16,164,236,20) -->
                        <Label Margin="16,0,3,0" HorizontalOptions="Fill" VerticalOptions="End" HeightRequest="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               Text="{Binding Descricao}" FontSize="12" TextColor="#555555" FontFamily="{StaticResource RobotoNormalFont}" />

                    </Grid>
                </StackLayout>
            </DataTemplate>


            <DataTemplate x:Key="ListaTemplate">
                <StackLayout Spacing="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <Label Style="{StaticResource labelGridItem}" Text="{Binding CodModelo}"  Grid.Row="0" Grid.Column="0"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding Descricao}"  Grid.Row="0" Grid.Column="1"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding DescricaoCor}"  Grid.Row="0" Grid.Column="2"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding Estoque}"  Grid.Row="0" Grid.Column="3"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding DataEntrega}"  Grid.Row="0" Grid.Column="4"/>
                        <Label Style="{StaticResource labelGridItem}" Text="{Binding Origem}"  Grid.Row="0" Grid.Column="5"/>
                        <StackLayout Grid.Row="0"
                                 Grid.Column="6"
                                 HorizontalOptions="Start"
                                 Spacing="0"
                                 >

                            <ffimageloading:CachedImage 
                                                DownsampleToViewSize="True"
                                                BackgroundColor="Transparent"
                                                Source="{Binding ItemEPromocao, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',promocao.png'}" 
                                                HorizontalOptions="End"
                                                VerticalOptions="Center"
                                                HeightRequest="20"
                                                Margin="3,0,0,0"
                                                Aspect="AspectFit">
                            </ffimageloading:CachedImage>

                            <ffimageloading:CachedImage 
                                                DownsampleToViewSize="True"
                                                BackgroundColor="Transparent"
                                                Source="{Binding ItemEProntaEntrega, Converter={StaticResource BoleanoParaImagem}, ConverterParameter=',pe.png'}" 
                                                HorizontalOptions="End"
                                                VerticalOptions="Center"
                                                HeightRequest="20"
                                                Margin="3,0,0,0"
                                                Aspect="AspectFit">
                            </ffimageloading:CachedImage>
                        </StackLayout>

                    </Grid>

                    <BoxView HeightRequest="1.5" Color="Silver" HorizontalOptions="FillAndExpand"/>
                </StackLayout>
            </DataTemplate>

            <DataTemplate x:Key="HeaderListaTemplate">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="1.75*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Style="{StaticResource labelGridHeader}" Text="Código"  Grid.Row="0" Grid.Column="0"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Modelo"  Grid.Row="0" Grid.Column="1"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Cor"  Grid.Row="0" Grid.Column="2"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Qtd. Disponível"  Grid.Row="0" Grid.Column="3"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Data de Entrega"  Grid.Row="0" Grid.Column="4"/>
                        <Label Style="{StaticResource labelGridHeader}" Text="Org. Estoque"  Grid.Row="0" Grid.Column="5"/>
                        <Label Style="{StaticResource labelGridHeader}" Text=""  Grid.Row="0" Grid.Column="6"/>

                    </Grid>
            </DataTemplate>



            <dataTemplate:ModeloTemplateSelector x:Key="ModeloTemplateSelector"
                                             CatalogoTemplate="{StaticResource CatalogoTemplate}"
                                             ListaTemplate="{StaticResource ListaTemplate}"
                                             />

            <dataTemplate:HeaderModeloTemplateSelector x:Key="HeaderModeloTemplateSelector"
                                                       HeaderListaTemplate="{StaticResource HeaderListaTemplate}"/>

            <DataTemplate x:Key="ClienteSelecaoTemplate">
                <ViewCell>
                    <StackLayout>
                        <Grid Margin="5"
                              RowSpacing="2"
                              ColumnSpacing="5"
                              HeightRequest="50">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <!-- LINHA 1 -->
                            <StackLayout Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                                <Label 
                                   Text="{Binding RazaoSocial}"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   FontAttributes="Bold"/>

                                <Label 
                                   Text="-"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   FontAttributes="Bold"/>

                                <Label 
                                   Text="{Binding CNPJ}"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   FontAttributes="Bold"/>
                            </StackLayout>
                            

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CodPessoaCliente}"
                                   FontSize="13"
                                   HorizontalOptions="End"/>

                            <ffimageloading:CachedImage Grid.Row="0"
                                                         Grid.Column="2"
                                                         HeightRequest="20"
                                                         WidthRequest="20"
                                                         Source="info.png"
                                                         HorizontalOptions="End"
                                                         VerticalOptions="Center">
                                <ffimageloading:CachedImage.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding InfoCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </ffimageloading:CachedImage.GestureRecognizers>
                            </ffimageloading:CachedImage>

                              <!-- LINHA 2 -->
                              <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding NomeFantasia}"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   FontAttributes="Bold"/>


                            <!-- LINHA 3 -->
                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding EnderecoPrincipalCompleto}"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"/>

                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Cidade}"
                                   FontSize="12"
                                   HorizontalOptions="End"/>

                            <Label Grid.Row="2" Grid.Column="2"
                                   Text="{Binding UF}"
                                   FontSize="12"
                                   HorizontalOptions="End"/>
                        </Grid>

                        <BoxView  HeightRequest="0.5" 
                                  HorizontalOptions="FillAndExpand"
                                  Color="Black"/>

                        <StackLayout.Triggers>
                            <DataTrigger TargetType="StackLayout"
                                         Binding="{Binding CodSituacaoCliente}" 
                                         Value="2">

                                <Setter Property="BackgroundColor" Value="Red"/>
                            </DataTrigger>
                        </StackLayout.Triggers>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>


        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>