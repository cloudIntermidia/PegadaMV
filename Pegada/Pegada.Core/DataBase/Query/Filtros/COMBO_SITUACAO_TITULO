-- Pegada: igual ao FiltrosTitulo.setupWithSituacao do PegadaIOS, lista todas as situações da tabela, sem filtrar pelos títulos
-- (a versão filtrada comparava o número da nota do "Ver Títulos" com o NumeroTitulo e só sobrava o (TODOS)).
-- Descrição sem o código na frente ("Aberto" em vez de "(1) Aberto").
SELECT Codigo, Descricao
FROM (
	SELECT '-1' AS Codigo,
	       '(TODOS)' AS Descricao,
	       -1 AS Ordem
	UNION ALL
	SELECT CAST(S.CodSituacaoTitulo AS TEXT) AS Codigo,
	       S.Descricao AS Descricao,
	       S.CodSituacaoTitulo AS Ordem
	FROM TBT_SITUACAO_TITULO S
	GROUP BY S.CodSituacaoTitulo
)
ORDER BY Ordem;
