AND QtdTotal = 0;


UPDATE TBT_CARRINHO
SET CodCondicaoPagamento = (
    SELECT CP.CodCondicaoPagamento 
    FROM TBT_CARRINHO C
    INNER JOIN TBT_CLIENTE CLI ON CLI.CodPessoaCliente = C.CodPessoaCliente
    INNER JOIN TBT_CONDICAO_PAGAMENTO CP ON CLI.CodCondicaoPagamento = CP.CodCondicaoPagamento 
    INNER JOIN TBT_TABELA_PRECO_COND_PGTO PGTO ON PGTO.CodCondicaoPagamento = CP.CodCondicaoPagamento
    INNER JOIN TBT_PESSOA_TABELA_PRECO PTP ON  PTP.CodTabelaPreco = PGTO.CodTabelaPreco 
     WHERE PTP.CodPessoa = C.CodPessoaRepresentante 
     AND CLI.CodPessoaCliente = C.CodPessoaCliente
     AND CP.IndAtivo = 1
    AND C.CodCarrinho = '@CodCarrinho'
LIMIT 1
)
WHERE CodCarrinho = '@CodCarrinho'
AND CodCondicaoPagamento IS NULL;


UPDATE TBT_ITEM_CARRINHO
SET PercDesc1 = IFNULL((
SELECT 
 Custom1 
 FROM TBT_TABELA_PRECO_COND_PGTO PGTO
 INNER JOIN TBT_CARRINHO C ON C.CodTabelaPreco = PGTO.CodTabelaPreco AND C.CodCondicaoPagamento = PGTO.CodCondicaoPagamento
 WHERE C.CodCarrinho = '@CodCarrinho'
 limit 1
), 0)
WHERE CodCarrinho = '@CodCarrinho';

UPDATE TBT_CARRINHO
SET  IsAplicaMarkup = (
    SELECT PermiteAjustePreco FROM TBT_CLIENTE CLI
    WHERE CLI.CodPessoaCliente = TBT_CARRINHO.CodPessoaCliente
)
WHERE CodCarrinho = '@CodCarrinho';

UPDATE TBT_CARRINHO
SET  Markup = (
    SELECT Markup FROM TBT_CLIENTE CLI
    WHERE CLI.CodPessoaCliente = TBT_CARRINHO.CodPessoaCliente
)
WHERE CodCarrinho = '@CodCarrinho';

UPDATE TBT_ITEM_CARRINHO
SET  IsAplicaMarkup = (SELECT IsAplicaMarkup FROM TBT_CARRINHO C1 WHERE C1.CodCarrinho = '@CodCarrinho')
WHERE TBT_ITEM_CARRINHO.CodCarrinho = '@CodCarrinho';

UPDATE TBT_ITEM_CARRINHO
SET Markup = CASE WHEN IsAplicaMarkup = 1 THEN 
(SELECT
  MA.Markup 
  FROM TBT_MARKUP_ATRIBUTO  MA, TBT_PRODUTO P, TBT_CLIENTE C, TBT_CARRINHO CA
  WHERE 1 = 1 
  AND MA.CodAtributo IN( IDProduto ,IDModelo, IDLinha, IDSubCategoria, IDCategoria, '-1' )
  AND (MA.CodPessoaCliente = C.CodPessoaCliente OR MA.CodPessoaCliente = '-1') 
  AND (MA.CodGrupoCliente = C.CodGrupoCliente OR MA.CodGrupoCliente = '-1') 
  AND MA.IndAtivo = 1 
  AND CA.CodPessoaCliente = C.CodPessoaCliente
  AND CA.CodCarrinho = '@CodCarrinho'
  AND P.CodProduto = TBT_ITEM_CARRINHO.CodProduto
 ORDER BY CASE WHEN CodAtributo = IDProduto THEN 1 
               WHEN CodAtributo = IDModelo THEN 2 
               WHEN CodAtributo = IDLinha THEN 3 
               WHEN CodAtributo = IDSubCategoria THEN 4 
               WHEN CodAtributo = IDCategoria THEN 5 
               ELSE 6 END)
               ELSE 0 END
WHERE CodCarrinho = '@CodCarrinho';

UPDATE TBT_ITEM_CARRINHO
SET ValorUnitarioLiquido = ValorUnitario
WHERE CodCarrinho = '@CodCarrinho';


UPDATE TBT_ITEM_CARRINHO 
SET ValorUnitarioLiquido =  CASE WHEN IsAplicaMarkup = 1 
    THEN
        CASE WHEN IFNULL(Markup, 0) > 0 
            THEN  Round((SELECT PrecoPVL - (PrecoPVL * (CAST(Desconto AS float) / 100)) FROM TBT_ITEM_TABELA_PRECO ITP WHERE ITP.CodProduto = TBT_ITEM_CARRINHO.CodProduto AND ITP.CodTabelaPreco = TBT_ITEM_CARRINHO.CodTabelaPreco) / Markup, 2)
            ELSE Round((ValorUnitarioLiquido - (ValorUnitarioLiquido * IFNULL(PercDesc1, 0.0)/100.0)), 2)
        END
ELSE 
    Round((ValorUnitarioLiquido - (ValorUnitarioLiquido * IFNULL(PercDesc1, 0.0)/100.0)), 2)
END
 WHERE CodCarrinho = '@CodCarrinho';

