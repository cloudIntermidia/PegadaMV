<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="clr-namespace:Prism.Mvvm;assembly=Prism.Forms"
             prism:ViewModelLocator.AutowireViewModel="True"
             xmlns:flex="clr-namespace:Flex.Controls;assembly=Flex"
             xmlns:controls="clr-namespace:MobiliVendas.Core.CustomView.Controls.SegmentedControl;assembly=MobiliVendas.Core"
             xmlns:syncfusion="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
             xmlns:translator="clr-namespace:MobiliVendas.Core.Helpers;assembly=MobiliVendas.Core"
             mc:Ignorable="d"
             x:Class="Pegada.Core.Views.Negocio.CadastroClientePage"
             x:Name="this">
    <ContentPage.Content>
        <AbsoluteLayout VerticalOptions="FillAndExpand"
                    HorizontalOptions="FillAndExpand">

            <StackLayout AbsoluteLayout.LayoutFlags="All"
                  AbsoluteLayout.LayoutBounds="0,0,1,0.92"
                  BackgroundColor="#DCDCDC"
                  VerticalOptions="FillAndExpand"
                  Spacing="0">


                <Grid Padding="20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <flex:FlexButton
                        Grid.Row="0" Grid.Column="0"
                        WidthRequest="350"
                        HorizontalOptions="Start"
                        Text="{Binding BindingContext.Cliente.RazaoSocial, Source={x:Reference this}, Converter={x:StaticResource TextSubText}, ConverterParameter={translator:Translate PegCadClienteBtnSelecionarCliente}}"
                        ClickedCommand="{Binding BindingContext.SelecionarClienteCommand, Source={x:Reference this}}"
                        Style="{StaticResource flexButtonFiltros}"
                        />

                    <StackLayout Grid.Row="0" Grid.Column="1"
                             Orientation="Horizontal"
                             HorizontalOptions="End"
                             IsVisible="{Binding BindingContext.MantemCadastro, Source={x:Reference this}}">

                        <flex:FlexButton IsVisible="True"
                            Text="{translator:Translate PegCadClienteBtnEditarCadastro}"
                            HorizontalOptions="End"
                            ClickedCommand="{Binding BindingContext.EditarClienteCommand, Source={x:Reference this}}"
                            Style="{StaticResource flexButtonFiltros}"
                            />

                        <flex:FlexButton
                        Text="{translator:Translate EdicaoAtendimentoBtnTransmitirCliente}"
                        HorizontalOptions="End"
                        ClickedCommand="{Binding BindingContext.TransmitirClienteCommand, Source={x:Reference this}}"
                        Style="{StaticResource flexButtonFiltros}"
                        />

                        <flex:FlexButton IsVisible="True"
                            Text="{translator:Translate SelecaoClienteBtnNovoCliente}"
                            HorizontalOptions="End"
                            ClickedCommand="{Binding BindingContext.CadastrarClienteNovoCommand, Source={x:Reference this}}"
                            Style="{StaticResource flexButtonFiltros}"
                         />
                    </StackLayout>

                </Grid>

                <ScrollView VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <StackLayout Spacing="0">

                <!-- ===================== CARD PRINCIPAL (Dados do Cliente + Endereço + Outros) ===================== -->
                <Grid BackgroundColor="White"
                      HorizontalOptions="FillAndExpand"
                      Padding="20,15"
                      RowSpacing="4"
                      >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <!-- Dados do Cliente: -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{translator:Translate PegCadClienteLblDadosCliente}"
                           FontFamily="{StaticResource RobotoBoldFont}"
                           FontAttributes="Bold"
                           TextColor="Gray"
                           FontSize="16"
                           />

                    <Label Grid.Row="1" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblRazaoSocial}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.RazaoSocial, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblNomeFantasia}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.NomeFantasia, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="2" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblCNPJ}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.CNPJ, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="2" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblIE}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.InscricaoEstadual, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="3" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblEmailNFE}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EmailNFE, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="4" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblRepresentante}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.Representante, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="5" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblHomePage}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.Homepage, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="5" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblSuframa}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.Suframa, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="5" Grid.Column="2" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblValidadeSuframa}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.DataValidadeSuframa, Source={x:Reference this}, StringFormat='{0:dd/MM/yyyy}'}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="6" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblRede}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.RedeCliente, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                </Grid>

                <!-- ===================== ABAS DE ENDEREÇO ===================== -->
                <Grid BackgroundColor="White" HorizontalOptions="FillAndExpand" Padding="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <controls:SegmentedControl x:Name="SegmentedEndereco"
                                               SelectedTextColor="Black"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                TintColor="#555"
                                                OnSegmentSelected="SegmentedControl_OnSegmentSelectedEndereco">
                        <controls:SegmentedControl.Children>
                            <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegEnderecoPrincipal}" />
                            <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegEnderecoCobranca}" />
                            <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegEnderecoEntrega}" />
                            <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegDadosBancarios}" />
                        </controls:SegmentedControl.Children>
                    </controls:SegmentedControl>

                </Grid>

                <!-- Endereço Principal -->
                <Grid x:Name="GridEnderecoPrincipal"
                      IsVisible="True"
                      BackgroundColor="White"
                      HorizontalOptions="FillAndExpand"
                      Padding="20,4,20,10"
                      RowSpacing="4"
                      >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblRuaAv}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoPrincipal.EnderecoUI, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="0" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblComplemento}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoPrincipal.Complemento, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="1" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblCidade}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoPrincipal.Cidade, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblPais}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: sem campo correspondente em ClienteCommandResult ainda -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="2" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblUF}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoPrincipal.UF, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="2" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblTelefone}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoPrincipal.Telefone, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="2" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblBairro}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoPrincipal.Bairro, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="2" Grid.Column="2" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblCEP}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoPrincipal.CEP, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="3" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblFax}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoPrincipal.Fax, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>

                <!-- Endereço de Cobrança -->
                <Grid x:Name="GridEnderecoCobranca"
                      IsVisible="False"
                      BackgroundColor="White"
                      HorizontalOptions="FillAndExpand"
                      Padding="20,4,20,10"
                      RowSpacing="4"
                      >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblRuaAv}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoCobranca.EnderecoUI, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="0" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblComplemento}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoCobranca.Complemento, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="1" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblCidade}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoCobranca.Cidade, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblPais}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: sem campo correspondente em ClienteCommandResult ainda -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="2" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblUF}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoCobranca.UF, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="2" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblTelefone}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoCobranca.Telefone, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="2" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblBairro}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoCobranca.Bairro, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="2" Grid.Column="2" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblCEP}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.EnderecoCobranca.CEP, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>

                <!-- Endereço de Entrega -->
                <Grid x:Name="GridEnderecoEntrega"
                      IsVisible="False"
                      BackgroundColor="White"
                      HorizontalOptions="FillAndExpand"
                      Padding="20,4,20,10"
                      RowSpacing="4"
                      >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblRuaAv}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: Cliente.EnderecoEntrega ainda não existe no model -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="0" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblComplemento}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: Cliente.EnderecoEntrega ainda não existe no model -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="1" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblCidade}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: Cliente.EnderecoEntrega ainda não existe no model -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblPais}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: sem campo correspondente em ClienteCommandResult ainda -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="2" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblUF}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: Cliente.EnderecoEntrega ainda não existe no model -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="2" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblTelefone}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: Cliente.EnderecoEntrega ainda não existe no model -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="2" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblBairro}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: Cliente.EnderecoEntrega ainda não existe no model -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="2" Grid.Column="2" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblCEP}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <!-- TODO: Cliente.EnderecoEntrega ainda não existe no model -->
                                <Span Text="" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>

                <!-- Dados Bancários -->
                <Grid x:Name="GridDadosBancarios"
                      IsVisible="False"
                      BackgroundColor="White"
                      HorizontalOptions="FillAndExpand"
                      Padding="20,4,20,10"
                      RowSpacing="4"
                      >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblCodBancario}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.Banco, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="0" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblNomeBanco}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.NomeBanco, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="1" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblAgencia}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.Agencia, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblContaCorrente}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.Conta, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblNomeTitular}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.NomeTitularConta, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="3" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblTipoChavePix}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.TipoChavePix, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="3" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblChavePix}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.ChavePix, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>

                <BoxView HeightRequest="1" Color="#DDDDDD" BackgroundColor="White" Margin="20,0"/>

                <!-- ===================== OUTROS ===================== -->
                <Grid BackgroundColor="White"
                      HorizontalOptions="FillAndExpand"
                      Padding="20,10"
                      RowSpacing="6"
                      >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{translator:Translate PegCadClienteLblOutros}"
                           FontFamily="{StaticResource RobotoBoldFont}"
                           FontAttributes="Bold"
                           TextColor="Gray"
                           FontSize="16"
                           />

                    <Label Grid.Row="1" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblCondPagamentos}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.CondicaoPagamentoDescricao, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblSitComercial}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.CodSituacaoCliente, Source={x:Reference this}, Converter={StaticResource SituacaoClienteParaTextoConverter}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="2" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblLimiteCredGrupoPed}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.LimiteCreditoGrupo, Source={x:Reference this}, Converter={x:StaticResource ValorParaMoeda}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="2" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblLimiteCredGrupoFat}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.LimiteFaturamento, Source={x:Reference this}, Converter={x:StaticResource ValorParaMoeda}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="3" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblLimiteCredClientePed}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.LimiteCredito, Source={x:Reference this}, Converter={x:StaticResource ValorParaMoeda}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Row="3" Grid.Column="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblLimiteCredClienteFat}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.LimiteTotal, Source={x:Reference this}, Converter={x:StaticResource ValorParaMoeda}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="4" Grid.Column="0" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{translator:Translate PegCadClienteLblClasseRisco}" FontFamily="{StaticResource RobotoBoldFont}" FontSize="Micro" FontAttributes="Bold" TextColor="Black"/>
                                <Span Text="{Binding BindingContext.Cliente.DescricaoClasseRisco, Source={x:Reference this}}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Linha de indicadores (checkboxes) -->
                    <StackLayout Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                 Orientation="Horizontal"
                                 Spacing="18"
                                 VerticalOptions="Center">

                        <StackLayout Orientation="Horizontal" Spacing="4">
                            <ffimageloading:CachedImage Aspect="AspectFit" HeightRequest="16" WidthRequest="16"
                                Source="{Binding BindingContext.Cliente.IndFatParcial, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='square_uncheck.png,square_check.png'}" />
                            <Label Text="{translator:Translate PegCadClienteChkFatParcial}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="Black" VerticalTextAlignment="Center"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" Spacing="4">
                            <ffimageloading:CachedImage Aspect="AspectFit" HeightRequest="16" WidthRequest="16"
                                Source="{Binding BindingContext.Cliente.IndFatAntecipado, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='square_uncheck.png,square_check.png'}" />
                            <Label Text="{translator:Translate PegCadClienteChkFatAntecipado}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="Black" VerticalTextAlignment="Center"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" Spacing="4">
                            <ffimageloading:CachedImage Aspect="AspectFit" HeightRequest="16" WidthRequest="16"
                                Source="{Binding BindingContext.Cliente.CompraPrecoLiquido, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='square_uncheck.png,square_check.png'}" />
                            <Label Text="{translator:Translate PegCadClienteChkPrecoLiquido}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="Black" VerticalTextAlignment="Center"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" Spacing="4">
                            <ffimageloading:CachedImage Aspect="AspectFit" HeightRequest="16" WidthRequest="16"
                                Source="{Binding BindingContext.Cliente.IndAtivo, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='square_uncheck.png,square_check.png'}" />
                            <Label Text="{translator:Translate SelecaoClienteStatusAtivo}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="Black" VerticalTextAlignment="Center"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" Spacing="4">
                            <ffimageloading:CachedImage Aspect="AspectFit" HeightRequest="16" WidthRequest="16"
                                Source="{Binding BindingContext.Cliente.PermiteDigitacao, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='square_uncheck.png,square_check.png'}" />
                            <Label Text="{translator:Translate PegCadClienteChkPermiteDigitacao}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="Black" VerticalTextAlignment="Center"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" Spacing="4">
                            <ffimageloading:CachedImage Aspect="AspectFit" HeightRequest="16" WidthRequest="16"
                                Source="{Binding BindingContext.Cliente.PermiteAjustePreco, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='square_uncheck.png,square_check.png'}" />
                            <Label Text="{translator:Translate PegCadClienteChkPermiteAjustePreco}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="Black" VerticalTextAlignment="Center"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" Spacing="4">
                            <ffimageloading:CachedImage Aspect="AspectFit" HeightRequest="16" WidthRequest="16"
                                Source="{Binding BindingContext.Cliente.CreditoLiberado, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='square_uncheck.png,square_check.png'}" />
                            <Label Text="{translator:Translate PegCadClienteChkCreditoLiberado}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="Black" VerticalTextAlignment="Center"/>
                        </StackLayout>

                    </StackLayout>

                </Grid>

                <!-- ===================== CONTATOS / CONTATOS GRUPO / REFERÊNCIAS ===================== -->
                <Grid BackgroundColor="White"
                      HorizontalOptions="FillAndExpand"
                      Padding="0,10,0,0"
                      >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <controls:SegmentedControl x:Name="SegmentedContato"
                                               SelectedTextColor="Black"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                TintColor="#555"
                                                OnSegmentSelected="SegmentedControl_OnSegmentSelectedContato">
                        <controls:SegmentedControl.Children>
                            <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegContatos}" />
                            <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegContatosGrupo}" />
                            <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegReferencias}" />
                        </controls:SegmentedControl.Children>
                    </controls:SegmentedControl>

                    <flex:FlexButton x:Name="ButtonNovoContatoReferencia"
                        Grid.Row="0" Grid.Column="1"
                        Text="{translator:Translate PegCadClienteBtnNovoContato}"
                        ClickedCommand="{Binding BindingContext.NovoContatoCommand, Source={x:Reference this}}"
                        Style="{StaticResource flexButtonFiltros}"
                        />

                </Grid>

                <!-- Cabeçalho de colunas: Nome | E-mail | Telefone | Cargo | Data Nasc. | Status -->
                <Grid x:Name="GridHeaderContato"
                      IsVisible="True"
                      BackgroundColor="#808080"
                      HorizontalOptions="FillAndExpand"
                      Padding="10,6"
                      >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Text="{translator:Translate PegCadClienteHeaderNome}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="White"/>
                    <Label Grid.Column="1" Text="{translator:Translate CatalogoImpressaoEmail}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="White"/>
                    <Label Grid.Column="2" Text="{translator:Translate PegCadClienteHeaderTelefone}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="White"/>
                    <Label Grid.Column="3" Text="{translator:Translate PegCadClienteHeaderCargo}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="White"/>
                    <Label Grid.Column="4" Text="{translator:Translate PegCadClienteHeaderDataNasc}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="White"/>
                    <Label Grid.Column="5" Text="{translator:Translate SelecaoClienteHeaderStatus}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="White"/>
                </Grid>

                <!-- Cabeçalho de colunas: Referências -->
                <Grid x:Name="GridHeaderReferencia"
                      IsVisible="False"
                      BackgroundColor="#808080"
                      HorizontalOptions="FillAndExpand"
                      Padding="10,6"
                      >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Text="{translator:Translate PegCadClienteHeaderReferencia}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="White"/>
                    <Label Grid.Column="1" Text="{translator:Translate PegCadClienteHeaderContato}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="White"/>
                    <Label Grid.Column="2" Text="{translator:Translate PegCadClienteHeaderTelefone}" FontFamily="{StaticResource RobotoBoldFont}" FontAttributes="Bold" FontSize="Micro" TextColor="White"/>
                </Grid>

                <!-- Lista: Contatos -->
                <syncfusion:SfListView x:Name="ListViewContatos"
                      IsVisible="True"
                      BackgroundColor="White"
                      HeightRequest="220"
                      Padding="10,0"
                      ItemSize="30"
                      ItemSpacing="2"
                      ItemsSource="{Binding BindingContext.Contatos, Source={x:Reference this}}"
                      TapCommand="{Binding BindingContext.EditarContatoCommand, Source={x:Reference this}}">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="{Binding Nome}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="1" Text="{Binding Email}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="2" Text="{Binding Telefone}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="3" Text="{Binding Cargo}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="4" Text="{Binding DataNascimento}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="5" Text="{Binding Status}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>

                <!-- Lista: Contatos Grupo -->
                <syncfusion:SfListView x:Name="ListViewContatosGrupo"
                      IsVisible="False"
                      BackgroundColor="White"
                      HeightRequest="220"
                      Padding="10,0"
                      ItemSize="30"
                      ItemSpacing="2"
                      ItemsSource="{Binding BindingContext.ContatosGrupo, Source={x:Reference this}}">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="{Binding Nome}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="1" Text="{Binding Email}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="2" Text="{Binding Telefone}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="3" Text="{Binding Cargo}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="4" Text="{Binding DataNascimento}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="5" Text="{Binding Status}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>

                <!-- Lista: Referências -->
                <syncfusion:SfListView x:Name="ListViewReferencias"
                      IsVisible="False"
                      BackgroundColor="White"
                      HeightRequest="220"
                      Padding="10,0,10,20"
                      ItemSize="30"
                      ItemSpacing="2">
                    <!-- TODO: Cliente.Referencias ainda não existe no model -->
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="{Binding Nome}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="1" Text="{Binding Contato}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                    <Label Grid.Column="2" Text="{Binding Telefone}" FontFamily="{StaticResource RobotoNormalFont}" FontSize="Micro"/>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>

                </StackLayout>
                </ScrollView>
            </StackLayout>
        </AbsoluteLayout>
    </ContentPage.Content>
</ContentPage>
