                        <Image AbsoluteLayout.LayoutBounds="8,372,17,17" Style="{StaticResource cadCheck}"
                               Source="{Binding BindingContext.Cliente.IndFatParcial, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='g_check_off.png,g_check_on.png'}" />
                        <Label AbsoluteLayout.LayoutBounds="28,372,77,17" Style="{StaticResource cadRotuloEsq}" Text="{translator:Translate PegCadClienteChkFatParcial}" />

                        <Image AbsoluteLayout.LayoutBounds="126,372,17,17" Style="{StaticResource cadCheck}"
                               Source="{Binding BindingContext.Cliente.IndFatAntecipado, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='g_check_off.png,g_check_on.png'}" />
                        <Label AbsoluteLayout.LayoutBounds="146,372,109,17" Style="{StaticResource cadRotuloEsq}" Text="{translator:Translate PegCadClienteChkFatAntecipado}" />

                        <Image AbsoluteLayout.LayoutBounds="269,372,17,17" Style="{StaticResource cadCheck}"
                               Source="{Binding BindingContext.Cliente.CompraPrecoLiquido, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='g_check_off.png,g_check_on.png'}" />
                        <Label AbsoluteLayout.LayoutBounds="287,372,95,17" Style="{StaticResource cadRotuloEsq}" Text="{translator:Translate PegCadClienteChkPrecoLiquido}" />

                        <Image AbsoluteLayout.LayoutBounds="394,372,17,17" Style="{StaticResource cadCheck}"
                               Source="{Binding BindingContext.Cliente.IndAtivo, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='g_check_off.png,g_check_on.png'}" />
                        <Label AbsoluteLayout.LayoutBounds="413,372,36,17" Style="{StaticResource cadRotuloEsq}" Text="{translator:Translate SelecaoClienteStatusAtivo}" />

                        <Image AbsoluteLayout.LayoutBounds="468,372,17,17" Style="{StaticResource cadCheck}"
                               Source="{Binding BindingContext.Cliente.PermiteDigitacao, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='g_check_off.png,g_check_on.png'}" />
                        <Label AbsoluteLayout.LayoutBounds="487,372,123,17" Style="{StaticResource cadRotuloEsq}" Text="{translator:Translate PegCadClienteChkPermiteDigitacao}" />

                        <!-- PegadaIOS (CadastroViewController): o pAjustePreco nunca é preenchido, fica sempre desmarcado. -->
                        <Image AbsoluteLayout.LayoutBounds="629,372,17,17" Style="{StaticResource cadCheck}" Source="g_check_off.png" />
                        <Label AbsoluteLayout.LayoutBounds="648,372,145,17" Style="{StaticResource cadRotuloEsq}" Text="{translator:Translate PegCadClienteChkPermiteAjustePreco}" />

                        <Image AbsoluteLayout.LayoutBounds="805,372,17,17" Style="{StaticResource cadCheck}"
                               Source="{Binding BindingContext.Cliente.CreditoLiberado, Source={x:Reference this}, Converter={x:StaticResource BoleanoParaImagem}, ConverterParameter='g_check_off.png,g_check_on.png'}" />
                        <Label AbsoluteLayout.LayoutBounds="824,372,116,17" Style="{StaticResource cadRotuloEsq}" Text="{translator:Translate PegCadClienteChkCreditoLiberado}" />

                        <!-- Borda branca de 5 (layer.borderWidth), desenhada por cima do conteúdo como no iOS -->
                        <BoxView AbsoluteLayout.LayoutBounds="0,0,950,5" Color="White" InputTransparent="True" />
                        <BoxView AbsoluteLayout.LayoutBounds="0,394,950,5" Color="White" InputTransparent="True" />
                        <BoxView AbsoluteLayout.LayoutBounds="0,0,5,399" Color="White" InputTransparent="True" />
                        <BoxView AbsoluteLayout.LayoutBounds="945,0,5,399" Color="White" InputTransparent="True" />
                    </AbsoluteLayout>
                </Frame>

                <!-- ===================== CONTATOS (35,443,950,...) ===================== -->
                <!-- Cabeçalho Contatos Cliente / Contatos Grupo (y 28) -->
                <AbsoluteLayout x:Name="GridHeaderContato" AbsoluteLayout.LayoutBounds="35,471,950,21" BackgroundColor="White" IsVisible="True">
                    <Label AbsoluteLayout.LayoutBounds="0,1,220,21" Style="{StaticResource cadCabecalho}" Text="{translator:Translate PegCadClienteHeaderNome}" />
                    <Label AbsoluteLayout.LayoutBounds="221,1,240,21" Style="{StaticResource cadCabecalho}" Text="{translator:Translate CatalogoImpressaoEmail}" />
                    <Label AbsoluteLayout.LayoutBounds="462,1,99,21" Style="{StaticResource cadCabecalho}" Text="{translator:Translate PegCadClienteHeaderTelefone}" />
                    <Label AbsoluteLayout.LayoutBounds="562,1,184,21" Style="{StaticResource cadCabecalho}" Text="{translator:Translate PegCadClienteHeaderCargo}" />
                    <Label AbsoluteLayout.LayoutBounds="747,1,87,21" Style="{StaticResource cadCabecalho}" Text="{translator:Translate PegCadClienteHeaderDataNasc}" />
                    <Label AbsoluteLayout.LayoutBounds="835,1,115,21" Style="{StaticResource cadCabecalho}" Text="{translator:Translate SelecaoClienteHeaderStatus}" />
                </AbsoluteLayout>

                <!-- Cabeçalho Referências (H1D-BI-26S) -->
                <AbsoluteLayout x:Name="GridHeaderReferencia" AbsoluteLayout.LayoutBounds="35,471,950,21" BackgroundColor="White" IsVisible="False">
                    <Label AbsoluteLayout.LayoutBounds="0,1,292,21" Style="{StaticResource cadCabecalho}" Text="{translator:Translate PegCadClienteHeaderReferencia}" />
                    <Label AbsoluteLayout.LayoutBounds="293,1,285,21" Style="{StaticResource cadCabecalho}" Text="{translator:Translate PegCadClienteHeaderContato}" />
                    <Label AbsoluteLayout.LayoutBounds="579,1,99,21" Style="{StaticResource cadCabecalho}" Text="{translator:Translate PegCadClienteHeaderTelefone}" />
                </AbsoluteLayout>

                <controls:SegmentedControl x:Name="SegmentedContato"
                                           AbsoluteLayout.LayoutBounds="35,443,343,32"
                                           SelectedTextColor="Black"
                                           TintColor="#555"
                                           OnSegmentSelected="SegmentedControl_OnSegmentSelectedContato">
                    <controls:SegmentedControl.Children>
                        <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegContatos}" />
                        <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegContatosGrupo}" />
                        <controls:SegmentedControlOption Text="{translator:Translate PegCadClienteSegReferencias}" />
                    </controls:SegmentedControl.Children>
                </controls:SegmentedControl>

                <flex:FlexButton x:Name="ButtonNovoContatoReferencia"
                                 AbsoluteLayout.LayoutBounds="823,443,163,27"
                                 Style="{StaticResource cadBotao}"
                                 Text="{translator:Translate PegCadClienteBtnNovoContato}"
                                 ClickedCommand="{Binding BindingContext.NovoContatoCommand, Source={x:Reference this}}" />
            </AbsoluteLayout>

            <!-- Tabela de contatos (0,49,950,...): fundo branco, linhas de 20 -->
            <Grid x:Name="TabelaContatos" Grid.Row="1" Margin="35,0,39,0" BackgroundColor="White" VerticalOptions="Start" HeightRequest="85">
                <!-- Contatos Cliente -->
                <syncfusion:SfListView x:Name="ListViewContatos"
                                       IsVisible="True"
                                       BackgroundColor="White"
                                       ItemSize="20"
                                       ItemSpacing="0"
                                       ItemHolding="ListViewContato_ItemHolding"
                                       ItemsSource="{Binding BindingContext.Contatos, Source={x:Reference this}}">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate>
                            <AbsoluteLayout HeightRequest="20" BackgroundColor="White">
                                <Label AbsoluteLayout.LayoutBounds="0,0,220,20" Style="{StaticResource cadCelula}" Text="{Binding Nome}" />
                                <Label AbsoluteLayout.LayoutBounds="221,0,240,20" Style="{StaticResource cadCelula}" Text="{Binding Email}" />
                                <Label AbsoluteLayout.LayoutBounds="462,0,98,20" Style="{StaticResource cadCelulaCentro}" Text="{Binding TelefoneCadastroUI}" />
                                <Label AbsoluteLayout.LayoutBounds="562,0,182,20" Style="{StaticResource cadCelulaCentro}" Text="{Binding Cargo}" />
                                <Label AbsoluteLayout.LayoutBounds="747,0,86,20" Style="{StaticResource cadCelulaCentro}" Text="{Binding DataNascimento, StringFormat='{0:dd/MM/yyyy}'}" />
                                <Label AbsoluteLayout.LayoutBounds="835,0,115,20" Style="{StaticResource cadCelulaCentro}" Text="{Binding Status}" />
                            </AbsoluteLayout>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>

                <!-- Contatos Grupo -->
                <syncfusion:SfListView x:Name="ListViewContatosGrupo"
                                       IsVisible="False"
                                       BackgroundColor="White"
                                       ItemSize="20"
                                       ItemSpacing="0"
                                       ItemHolding="ListViewContato_ItemHolding"
                                       ItemsSource="{Binding BindingContext.ContatosGrupo, Source={x:Reference this}}">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate>
                            <AbsoluteLayout HeightRequest="20" BackgroundColor="White">
                                <Label AbsoluteLayout.LayoutBounds="0,0,220,20" Style="{StaticResource cadCelula}" Text="{Binding Nome}" />
                                <Label AbsoluteLayout.LayoutBounds="221,0,240,20" Style="{StaticResource cadCelula}" Text="{Binding Email}" />
                                <Label AbsoluteLayout.LayoutBounds="462,0,98,20" Style="{StaticResource cadCelulaCentro}" Text="{Binding TelefoneCadastroUI}" />
                                <Label AbsoluteLayout.LayoutBounds="562,0,182,20" Style="{StaticResource cadCelulaCentro}" Text="{Binding Cargo}" />
                                <Label AbsoluteLayout.LayoutBounds="747,0,86,20" Style="{StaticResource cadCelulaCentro}" Text="{Binding DataNascimento, StringFormat='{0:dd/MM/yyyy}'}" />
                                <Label AbsoluteLayout.LayoutBounds="835,0,115,20" Style="{StaticResource cadCelulaCentro}" Text="{Binding Status}" />
                            </AbsoluteLayout>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>

                <!-- Referências. TODO: Cliente.Referencias ainda não existe no model -->
                <syncfusion:SfListView x:Name="ListViewReferencias"
                                       IsVisible="False"
                                       BackgroundColor="White"
                                       ItemSize="20"
                                       ItemSpacing="0">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate>
                            <AbsoluteLayout HeightRequest="20" BackgroundColor="White">
                                <Label AbsoluteLayout.LayoutBounds="0,0,292,20" Style="{StaticResource cadCelula}" Text="{Binding Nome}" />
                                <Label AbsoluteLayout.LayoutBounds="293,0,285,20" Style="{StaticResource cadCelula}" Text="{Binding Contato}" />
                                <Label AbsoluteLayout.LayoutBounds="579,0,99,20" Style="{StaticResource cadCelulaCentro}" Text="{Binding Telefone}" />
                            </AbsoluteLayout>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>
            </Grid>

            <!-- Menu do toque longo nos contatos (UIMenuController de -longPress:, PegadaIOS): balão Editar | Inativar sobre a linha -->
            <AbsoluteLayout x:Name="MenuContato" Grid.RowSpan="2" IsVisible="False">
                <BoxView AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Color="#01000000">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="FecharMenuContato_Tapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <BoxView x:Name="SetaMenuContato" AbsoluteLayout.LayoutBounds="0,0,14,14" Rotation="45" Color="#F7F7F7" />
                <Frame x:Name="BalaoMenuContato" AbsoluteLayout.LayoutBounds="0,0,160,40" Padding="0" CornerRadius="12" HasShadow="False" IsClippedToBounds="True"
                       BackgroundColor="#F7F7F7" BorderColor="#D0D0D0">
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" FontSize="15" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               Text="{translator:Translate PedidoTela_Global_Editar}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="EditarContato_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                        <BoxView Grid.Column="1" Color="#D0D0D0" />
                        <Label Grid.Column="2" FontSize="15" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               Text="{translator:Translate PegCadClienteBtnInativarContato}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="InativarContato_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Frame>
            </AbsoluteLayout>
        </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
