<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="clr-namespace:Prism.Mvvm;assembly=Prism.Forms"
             prism:ViewModelLocator.AutowireViewModel="True"
             xmlns:flex="clr-namespace:Flex.Controls;assembly=Flex"
             xmlns:controls="clr-namespace:MobiliVendas.Core.CustomView.Controls.SegmentedControl;assembly=MobiliVendas.Core"
             xmlns:syncfusion="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:translator="clr-namespace:MobiliVendas.Core.Helpers;assembly=MobiliVendas.Core"
             mc:Ignorable="d"
             x:Class="Pegada.Core.Views.Negocio.CadastroClientePage"
             x:Name="this">

    <!--
        Espelha a cena CadastroViewController do PegadaIOS (MainStoryboard "sXk-wb-SCd", 1024x610, fundo #D0D0D0).
        Todas as posições são os frames (x,y,largura,altura) do storyboard:
          - topo                 : Cliente (47,3,472,30) | Editar Cadastro (541,3,163,30) | Transmitir Cadastros (730,3,163,30)
          - quadro do cliente    : (35,36,950,399), borda branca de 5 e cantos de 8
              Dados do Cliente / endereços em abas (moldura cinza clara) / Outros / indicadores
          - contatos             : (35,443,950,...) abas Contatos Cliente | Contatos Grupo | Referências + Novo contato,
                                   cabeçalho cinza 50% e linhas de 20 com fonte 12
        Rótulos em negrito 14 alinhados à direita e valores com a fonte padrão do UILabel (17), como no iOS.
    -->
    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- IMComboButton / IMButton brancos do PegadaIOS (whiteButton), fonte padrão do UIButton (system 15) -->
            <Style x:Key="cadBotao" TargetType="flex:FlexButton">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="None" />
                <Setter Property="ForegroundColor" Value="#555555" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="HighlightForegroundColor" Value="#555555" />
                <Setter Property="HighlightBackgroundColor" Value="#E5E5E5" />
                <Setter Property="HighlightBorderColor" Value="#E5E5E5" />
                <Setter Property="MaxLines" Value="1" />
            </Style>

            <!-- "Dados do Cliente:" / "Outros:" -->
            <Style x:Key="cadTitulo" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#555555" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <!-- Rótulos: boldSystem 14, preto, alinhados à direita -->
            <Style x:Key="cadRotulo" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>
            <Style x:Key="cadRotuloEsq" TargetType="Label" BasedOn="{StaticResource cadRotulo}">
                <Setter Property="HorizontalTextAlignment" Value="Start" />
            </Style>

            <!-- Valores: fonte padrão do UILabel (system 17), preto -->
            <Style x:Key="cadValor" TargetType="Label">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <!-- Cabeçalho da lista de contatos: fundo #7F7F7F, branco, boldSystem 14 -->
            <Style x:Key="cadCabecalho" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="#7F7F7F" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <!-- Células da lista de contatos (ContRefTableViewCell): system 12, preto -->
            <Style x:Key="cadCelula" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>
            <Style x:Key="cadCelulaCentro" TargetType="Label" BasedOn="{StaticResource cadCelula}">
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <!-- Indicadores (g_check_off / g_check_on 17x17) -->
            <Style x:Key="cadCheck" TargetType="Image">
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid x:Name="RaizCadastro" BackgroundColor="#D0D0D0" VerticalOptions="FillAndExpand" SizeChanged="RaizCadastro_SizeChanged">
