        <Grid x:Name="BlocoCadastro"
              WidthRequest="1024"
              HorizontalOptions="Start"
              VerticalOptions="Start"
              AnchorX="0"
              AnchorY="0"
              RowSpacing="0"
              ColumnSpacing="0">
            <Grid.RowDefinitions>
                <!-- até o início da tabela de contatos: 443 + 49 -->
                <RowDefinition Height="492" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <AbsoluteLayout Grid.Row="0">

