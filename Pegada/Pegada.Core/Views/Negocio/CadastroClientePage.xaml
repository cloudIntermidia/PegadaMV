                                    <Label AbsoluteLayout.LayoutBounds="621,20,25,17" Style="{StaticResource cadValor}" Text="{Binding BindingContext.Cliente.EnderecoCobranca.UF, Source={x:Reference this}}" />
                                    <Label AbsoluteLayout.LayoutBounds="678,20,85,17" Style="{StaticResource cadRotulo}" Text="{translator:Translate PegCadClienteLblCEP}" />
                                    <Label AbsoluteLayout.LayoutBounds="769,20,130,17" Style="{StaticResource cadValor}" Text="{Binding BindingContext.Cliente.EnderecoCobranca.CEP, Source={x:Reference this}}" />

