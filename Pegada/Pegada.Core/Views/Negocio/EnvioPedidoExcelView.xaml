<?xml version="1.0" encoding="UTF-8"?>
<!-- Tela "Envio de Pedido" do PegadaIOS (EnvioPedidoExcelViewController, cena Vf3-PE-kJR do MainStoryboard, formSheet 400x280):
     cabeçalho e rodapé azuis de 46, texto explicativo, chave "Enviar somente..." que mostra o campo de e-mail, Cancelar | Enviar. -->
<pages:PopupPage xmlns="http://xamarin.com/schemas/2014/forms"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
                 xmlns:translator="clr-namespace:MobiliVendas.Core.Helpers;assembly=MobiliVendas.Core"
                 x:Class="Pegada.Core.Views.Negocio.EnvioPedidoExcelView"
                 CloseWhenBackgroundIsClicked="False"
                 BackgroundColor="#66000000">

    <Frame WidthRequest="400" HeightRequest="280"
           HorizontalOptions="Center" VerticalOptions="Center"
           Padding="0" CornerRadius="10" HasShadow="False" IsClippedToBounds="True"
           BackgroundColor="White">
        <Grid RowSpacing="0" ColumnSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0" BackgroundColor="#0F2F78">
                <Label Text="{translator:Translate EnvioPedidoExcelTitulo}"
                       FontSize="17" FontAttributes="Bold" TextColor="White"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Grid>

            <!-- Corpo (posições do storyboard, relativas ao fim do cabeçalho) -->
            <AbsoluteLayout Grid.Row="1">
                <Label AbsoluteLayout.LayoutBounds="15,8,371,63"
                       Text="{translator:Translate EnvioPedidoExcelTexto}"
                       FontSize="14" TextColor="Black"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

                <Label AbsoluteLayout.LayoutBounds="62,88,269,29"
                       Text="{translator:Translate EnvioPedidoExcelSomenteDigitados}"
                       FontSize="14" TextColor="Black"
                       HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                <Switch x:Name="SwitchSomenteDigitados"
                        AbsoluteLayout.LayoutBounds="333,86,51,31"
                        Toggled="OnSomenteDigitadosToggled" />

                <Label x:Name="LblEmail"
                       AbsoluteLayout.LayoutBounds="9,109,83,29"
                       Text="{translator:Translate EnvioPedidoExcelEmail}"
                       FontSize="17" TextColor="Black" VerticalTextAlignment="Center"
                       IsVisible="False" />
                <Entry x:Name="TxtEmail"
                       AbsoluteLayout.LayoutBounds="9,137,382,34"
                       FontSize="14" Keyboard="Email" TextColor="Black"
                       IsVisible="False" />
            </AbsoluteLayout>

            <!-- Rodapé: Cancelar | Enviar, com divisória branca no meio -->
            <Grid Grid.Row="2" BackgroundColor="#0F2F78" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Text="{translator:Translate EnvioPedidoExcelCancelar}"
                        FontSize="15" TextColor="White" BackgroundColor="Transparent"
                        Clicked="OnCancelarClicked" />
                <BoxView Grid.Column="1" Color="White" Margin="0,5" />
                <Button x:Name="BtnEnviar" Grid.Column="2"
                        Text="{translator:Translate EnvioPedidoExcelEnviar}"
                        FontSize="15" TextColor="White" BackgroundColor="Transparent"
                        Clicked="OnEnviarClicked" />
            </Grid>
        </Grid>
    </Frame>
</pages:PopupPage>
