<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:prism="clr-namespace:Prism.Mvvm;assembly=Prism.Forms"
             prism:ViewModelLocator.AutowireViewModel="True"
             xmlns:b="clr-namespace:Prism.Behaviors;assembly=Prism.Forms"
             xmlns:flex="clr-namespace:Flex.Controls;assembly=Flex"
             xmlns:translator="clr-namespace:MobiliVendas.Core.Helpers;assembly=MobiliVendas.Core"
             xmlns:syncfusion="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:conv="clr-namespace:Pegada.Core.Converters"
             x:Name="this"
             x:Class="Pegada.Core.Views.Negocio.PedidoPage">

    <!--
        Layout espelhado da tela PedidoViewController do PegadaIOS (MainStoryboard, cena 1024x610):
          - barra de filtros (45)         : Representante | Vendedor | Grupo | Cliente | Buscar Criticados | + Filtros | Consultar
          - lista de pedidos (234)        : cabeçalho (30) + linhas (50)
          - barra de totais (35)          : Qtd Pedidos | Qtd Total Itens | Valor Total
          - itens do pedido (restante)    : cabeçalho + linhas (30) + grade (esquerda) + foto (direita)
          - painel "+ Filtros" (320 de largura, à direita, sobre a tela)
        As larguras das colunas são proporcionais às posições (x, largura) do storyboard.
    -->
    <ContentPage.Resources>
        <ResourceDictionary>

            <conv:DataOuTextoConverter x:Key="DataOuTexto" />

            <!-- Botões brancos (IMButton / IMComboButton do PegadaIOS) -->
            <Style x:Key="pedBotao" TargetType="flex:FlexButton">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="ForegroundColor" Value="#555555" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="HighlightForegroundColor" Value="#555555" />
                <Setter Property="HighlightBackgroundColor" Value="#E5E5E5" />
                <Setter Property="HighlightBorderColor" Value="#E5E5E5" />
                <Setter Property="MaxLines" Value="1" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Cabeçalho da grade do item: cinza 50%, texto branco 14 -->
            <Style x:Key="pedGradeCabecalho" TargetType="Label">
                <Setter Property="WidthRequest" Value="31.5" />
                <Setter Property="HeightRequest" Value="21" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="#808080" />
                <Setter Property="LineBreakMode" Value="NoWrap" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <!-- Tela "Informações" do pedido: rótulos em negrito 12, valores 12 -->
            <Style x:Key="pedInfoRotulo" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="pedInfoValor" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <!-- Cabeçalhos das listas: negrito, branco, fundo cinza 50% -->
            <Style x:Key="pedCabecalho" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="#808080" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="MaxLines" Value="2" />
                <Setter Property="Margin" Value="0,0,1,0" />
            </Style>

            <!-- Células das listas -->
            <Style x:Key="pedCelula" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <!-- Textos da barra de totais -->
            <Style x:Key="pedTotal" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <!-- Painel de filtros -->
            <Style x:Key="pedFiltroRotulo" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout>

        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              BackgroundColor="White"
              RowSpacing="0"
              ColumnSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition Height="234" />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ BARRA DE FILTROS (eqA-25-6fg) ============ -->
            <Grid Grid.Row="0" BackgroundColor="#D9D9D9" ColumnSpacing="0" RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="152" />
                    <ColumnDefinition Width="152" />
                    <ColumnDefinition Width="152" />
                    <ColumnDefinition Width="158" />
                    <ColumnDefinition Width="121" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Representante -->
                <flex:FlexButton Grid.Column="0"
                                 Style="{StaticResource pedBotao}"
                                 WidthRequest="150" HeightRequest="33"
                                 Margin="0,0,0,2"
                                 IsEnabled="{Binding BindingContext.RepresentanteHabilitado, Source={x:Reference this}}"
                                 Text="{translator:Translate PedidoTela_PedidoVC_Representante}" />

                <!-- Vendedor -->
                <flex:FlexButton Grid.Column="1"
                                 Style="{StaticResource pedBotao}"
                                 WidthRequest="150" HeightRequest="33"
                                 Margin="0,0,0,2" MaxLines="2"
                                 IsEnabled="{Binding BindingContext.VendedorHabilitado, Source={x:Reference this}}"
                                 Text="{Binding BindingContext.TituloVendedor, Source={x:Reference this}}"
                                 ClickedCommand="{Binding BindingContext.SelecionarVendedorCommand, Source={x:Reference this}}" />

                <!-- Grupo -->
                <flex:FlexButton Grid.Column="2"
                                 Style="{StaticResource pedBotao}"
                                 WidthRequest="150" HeightRequest="33"
                                 Margin="0,0,0,2" MaxLines="2"
                                 Text="{Binding BindingContext.TituloGrupo, Source={x:Reference this}}"
                                 ClickedCommand="{Binding BindingContext.SelecionarGrupoCommand, Source={x:Reference this}}" />

                <!-- Cliente -->
                <flex:FlexButton Grid.Column="3"
                                 Style="{StaticResource pedBotao}"
                                 WidthRequest="150" HeightRequest="33"
                                 Margin="0,0,0,2" MaxLines="2"
                                 Text="{Binding BindingContext.TituloCliente, Source={x:Reference this}}"
                                 ClickedCommand="{Binding BindingContext.SelecionarClienteCommand, Source={x:Reference this}}" />

                <!-- Buscar Criticados -->
                <flex:FlexButton Grid.Column="4"
                                 Style="{StaticResource pedBotao}"
                                 WidthRequest="113" HeightRequest="33"
                                 Margin="0,0,0,2"
                                 FontSize="11" FontAttributes="None" MaxLines="2"
                                 Text="Buscar Criticados"
                                 ClickedCommand="{Binding BindingContext.BuscarCriticadosCommand, Source={x:Reference this}}" />

                <!-- + Filtros (abre o painel lateral) -->
                <flex:FlexButton Grid.Column="5"
                                 x:Name="BtnFiltros"
                                 Style="{StaticResource pedBotao}"
                                 WidthRequest="142" HeightRequest="30"
                                 Margin="0,3,0,0"
                                 Text="{translator:Translate PedidoTela_PEVC_Filtros}" />

                <!-- Ícone de filtro ativo (oculto até haver filtro aplicado) -->
                <Image Grid.Column="5"
                       x:Name="IconeFiltroAtivo"
                       Source="sem_grade.png"
                       IsVisible="{Binding BindingContext.FiltroAtivo, Source={x:Reference this}}"
                       WidthRequest="26" HeightRequest="26"
                       Margin="10,0,0,0"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       InputTransparent="True" />

                <!-- Consultar -->
                <flex:FlexButton Grid.Column="6"
                                 Style="{StaticResource pedBotao}"
                                 WidthRequest="142" HeightRequest="30"
                                 Margin="0,3,0,0"
                                 Text="{translator:Translate PedidoTela_PEVC_Consultar}"
                                 ClickedCommand="{Binding BindingContext.ConsultarCommand, Source={x:Reference this}}" />
            </Grid>

            <!-- ============ LISTA DE PEDIDOS (fV1-EY-8ed) ============ -->
            <Grid Grid.Row="1" RowSpacing="0" ColumnSpacing="0" BackgroundColor="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Grid.Row="0" ColumnSpacing="0" RowSpacing="0" Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*" />
                        <ColumnDefinition Width="33*" />
                        <ColumnDefinition Width="91*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="76*" />
                        <ColumnDefinition Width="211*" />
                        <ColumnDefinition Width="73*" />
                        <ColumnDefinition Width="47*" />
                        <ColumnDefinition Width="62*" />
                        <ColumnDefinition Width="67*" />
                        <ColumnDefinition Width="66*" />
                        <ColumnDefinition Width="42*" />
                        <ColumnDefinition Width="71*" />
                        <ColumnDefinition Width="69*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Style="{StaticResource pedCabecalho}" FontSize="14" />
                    <!-- Marca/desmarca todos -->
                    <Image Grid.Column="0"
                           Source="{Binding BindingContext.TodosPedidosChecados, Source={x:Reference this}, Converter={StaticResource BoleanoParaImagem}, ConverterParameter='atendimento_uncheck.png,atendimento_check.png'}"
                           WidthRequest="22" HeightRequest="22"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.MarcarTodosPedidosCommand, Source={x:Reference this}}" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label Grid.Column="1" Style="{StaticResource pedCabecalho}" FontSize="14" Text="{translator:Translate PedidoTela_Info}" />
                    <Label Grid.Column="2" Style="{StaticResource pedCabecalho}" Text="{translator:Translate PedidoTela_PedidoVC_PedidoAFV}" />
                    <Label Grid.Column="3" Style="{StaticResource pedCabecalho}" Text="{translator:Translate PedidoTela_PedidoVC_PedidoERP}" />
                    <Label Grid.Column="4" Style="{StaticResource pedCabecalho}" FontSize="12" Text="{translator:Translate PedidoTela_PedidoVC_OrdemCompra}" />
                    <Label Grid.Column="5" Style="{StaticResource pedCabecalho}" Text="{translator:Translate PedidoTela_PedidoVC_Cliente}" />
                    <Label Grid.Column="6" Style="{StaticResource pedCabecalho}" Text="{translator:Translate PedidoTela_PedidoVC_CondPgto}" />
                    <Label Grid.Column="7" Style="{StaticResource pedCabecalho}" FontSize="12" Text="{translator:Translate PedidoTela_PedidoVC_TipoPedido}" />
                    <Label Grid.Column="8" Style="{StaticResource pedCabecalho}" Text="{translator:Translate PedidoTela_PedidoVC_Situacao}" />
                    <Label Grid.Column="9" Style="{StaticResource pedCabecalho}" Text="{translator:Translate PedidoTela_PedidoVC_Emissao}" />
                    <Label Grid.Column="10" Style="{StaticResource pedCabecalho}" Text="{translator:Translate PedidoTela_CarrinhoTB_Faturamento}" />
                    <Label Grid.Column="11" Style="{StaticResource pedCabecalho}" Text="{translator:Translate PedidoTela_PedidoVC_Qtd}" />
                    <Label Grid.Column="12" Style="{StaticResource pedCabecalho}" Text="{translator:Translate PedidoTela_PedidoVC_Total}" />
                    <Label Grid.Column="13" Style="{StaticResource pedCabecalho}" Margin="0" Text="{translator:Translate PedidoTela_PedidoVC_TotalLiq}" />
                </Grid>

                <!-- Linhas (PedidoCell, altura 50) -->
                <syncfusion:SfListView Grid.Row="1"
                                       ItemSize="50"
                                       SelectionMode="None"
                                       TapCommand="{Binding BindingContext.PedidoTappedCommand, Source={x:Reference this}}"
                                       ItemsSource="{Binding BindingContext.Pedidos, Source={x:Reference this}}">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid ColumnSpacing="0" RowSpacing="0" HeightRequest="50" BackgroundColor="Transparent">
                                    <!-- Cor da linha por situação (colorForStatus): 7 vermelho, 8 verde, 9 amarelo -->
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding CodSituacaoPedido}" Value="7">
                                            <Setter Property="BackgroundColor" Value="#FF0000" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Grid" Binding="{Binding CodSituacaoPedido}" Value="8">
                                            <Setter Property="BackgroundColor" Value="#00FF00" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Grid" Binding="{Binding CodSituacaoPedido}" Value="9">
                                            <Setter Property="BackgroundColor" Value="#FFFF00" />
                                        </DataTrigger>
                                        <!-- Linha selecionada: cinza claro (vale sobre a cor da situação) -->
                                        <DataTrigger TargetType="Grid" Binding="{Binding Selecionado}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#D9D9D9" />
                                        </DataTrigger>
                                    </Grid.Triggers>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35*" />
                                        <ColumnDefinition Width="33*" />
                                        <ColumnDefinition Width="91*" />
                                        <ColumnDefinition Width="81*" />
                                        <ColumnDefinition Width="76*" />
                                        <ColumnDefinition Width="211*" />
                                        <ColumnDefinition Width="73*" />
                                        <ColumnDefinition Width="47*" />
                                        <ColumnDefinition Width="62*" />
                                        <ColumnDefinition Width="67*" />
                                        <ColumnDefinition Width="66*" />
                                        <ColumnDefinition Width="42*" />
                                        <ColumnDefinition Width="71*" />
                                        <ColumnDefinition Width="69*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Check do pedido -->
                                    <Image Grid.Column="0"
                                           Source="{Binding CarrinhoChecado, Converter={StaticResource BoleanoParaImagem}, ConverterParameter='atendimento_uncheck.png,atendimento_check.png'}"
                                           WidthRequest="22" HeightRequest="22"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.ChecarPedidoCommand, Source={x:Reference this}}"
                                                                  CommandParameter="{Binding .}" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <!-- Info (botão "i" cinza): seleciona a linha e abre as informações do pedido -->
                                    <Label Grid.Column="1" Text="ⓘ" FontSize="22" TextColor="#AAAAAA"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.InfoPedidoCommand, Source={x:Reference this}}"
                                                                  CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Label Grid.Column="2" Style="{StaticResource pedCelula}" Margin="0,4,0,9" Text="{Binding CodCarrinho}" />
                                    <Label Grid.Column="3" Style="{StaticResource pedCelula}" Margin="0,4,0,9" Text="{Binding CodPedido}" />
                                    <Label Grid.Column="4" Style="{StaticResource pedCelula}" Margin="0,4,0,9" FontSize="11" Text="{Binding OrdemCompra}" />

                                    <!-- Cliente: "Razão Social-CNPJ: ..." (a linha "REDE:" do iOS não tem origem no banco do MV) -->
                                    <Label Grid.Column="5" Style="{StaticResource pedCelula}" FontSize="9"
                                           Margin="0,4,0,9" VerticalTextAlignment="Start"
                                           MaxLines="3" Text="{Binding ClienteUI}" />

                                    <Label Grid.Column="6" Style="{StaticResource pedCelula}" Margin="0,4,0,9" Text="{Binding CondicaoPagamento}" />
                                    <Label Grid.Column="7" Style="{StaticResource pedCelula}" Margin="0,4,0,9" Text="{Binding TipoPedido}" />
                                    <Label Grid.Column="8" Style="{StaticResource pedCelula}" Margin="0,4,0,9" Text="{Binding Situacao}" />
                                    <Label Grid.Column="9" Style="{StaticResource pedCelula}" Margin="0,4,0,9" Text="{Binding DataEmissao, StringFormat='{0:dd/MM/yyyy}'}" />
                                    <Label Grid.Column="10" Style="{StaticResource pedCelula}" Margin="0,4,0,9" Text="{Binding DataEntrega, StringFormat='{0:dd/MM/yyyy}'}" />
                                    <Label Grid.Column="11" Style="{StaticResource pedCelula}" Margin="0,4,0,9" FontSize="11" Text="{Binding QtdTotalItens}" />
                                    <Label Grid.Column="12" Style="{StaticResource pedCelula}" Margin="0,4,0,9" FontSize="11" Text="{Binding ValorTotalItens, Converter={StaticResource ValorParaMoeda}}" />
                                    <Label Grid.Column="13" Style="{StaticResource pedCelula}" Margin="0,4,0,9" FontSize="11" Text="{Binding ValorTotalLiquido, Converter={StaticResource ValorParaMoeda}}" />
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>
            </Grid>

            <!-- ============ AÇÕES DO PEDIDO ============
                 Botões no lugar do menu de long-press do PegadaIOS (PedidoViewController.longPressPedido), como na tela de Carrinho.
                 Só aparecem as opções que o pedido selecionado permite (situação e tipo PE), na mesma ordem do menu do iOS:
                   situação 99: PE -> Editar, Ver Crítica, Copiar, Excel | demais -> Editar, Ver Crítica, Imprimir, Copiar, E-mail, Excel
                   outras:      PE -> Imprimir, E-mail, Excel          | demais -> (situação 1: + Cópia) Imprimir, E-mail, Excel -->
            <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" BackgroundColor="#F2F2F2"
                        FlowDirection="RightToLeft">
                <StackLayout Orientation="Horizontal" Spacing="8" Padding="10,5" VerticalOptions="Center">
                    <flex:FlexButton FlowDirection="LeftToRight" Style="{StaticResource flexButtonAction}" WidthRequest="130" HeightRequest="38" FontSize="11"
                                     Text="{translator:Translate PedidoTela_Global_Editar}"
                                     IsVisible="{Binding BindingContext.AcaoEditarVisivel, Source={x:Reference this}}"
                                     ClickedCommand="{Binding BindingContext.AlterarCommand, Source={x:Reference this}}" />
                    <flex:FlexButton FlowDirection="LeftToRight" Style="{StaticResource flexButtonAction}" WidthRequest="130" HeightRequest="38" FontSize="11"
                                     Text="{translator:Translate PedidoTela_Global_VerCritica}"
                                     IsVisible="{Binding BindingContext.AcaoVerCriticaVisivel, Source={x:Reference this}}"
                                     ClickedCommand="{Binding BindingContext.VerCriticasCommand, Source={x:Reference this}}" />
                    <flex:FlexButton FlowDirection="LeftToRight" Style="{StaticResource flexButtonAction}" WidthRequest="130" HeightRequest="38" FontSize="11"
                                     Text="{translator:Translate PedidoTela_Global_Imprimir}"
                                     IsVisible="{Binding BindingContext.AcaoImprimirVisivel, Source={x:Reference this}}"
                                     ClickedCommand="{Binding BindingContext.ImprimirCommand, Source={x:Reference this}}" />
                    <flex:FlexButton FlowDirection="LeftToRight" Style="{StaticResource flexButtonAction}" WidthRequest="130" HeightRequest="38" FontSize="11"
                                     Text="{translator:Translate PedidoTela_Global_Copia}"
                                     IsVisible="{Binding BindingContext.AcaoCopiarVisivel, Source={x:Reference this}}"
                                     ClickedCommand="{Binding BindingContext.CopiarCommand, Source={x:Reference this}}" />
                    <flex:FlexButton FlowDirection="LeftToRight" Style="{StaticResource flexButtonAction}" WidthRequest="140" HeightRequest="38" FontSize="11"
                                     Text="{translator:Translate PedidoTela_Global_EnviarPEmail}"
                                     IsVisible="{Binding BindingContext.AcaoImprimirVisivel, Source={x:Reference this}}"
                                     ClickedCommand="{Binding BindingContext.EnviarEmailCommand, Source={x:Reference this}}" />
                    <flex:FlexButton FlowDirection="LeftToRight" Style="{StaticResource flexButtonAction}" WidthRequest="170" HeightRequest="38" FontSize="11"
                                     Text="Enviar como Excel por E-mail"
                                     IsVisible="{Binding BindingContext.AcaoExcelEmailVisivel, Source={x:Reference this}}"
                                     ClickedCommand="{Binding BindingContext.EnviarExcelCommand, Source={x:Reference this}}" />
                </StackLayout>
            </ScrollView>

            <!-- ============ BARRA DE TOTAIS (NpZ-4C-jvU) ============ -->
            <Grid Grid.Row="3" BackgroundColor="#AAAAAA" ColumnSpacing="0" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="129" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="99" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="1" Style="{StaticResource pedTotal}"
                       Text="{translator:Translate PedidoTela_PedidoVC_QtdPedidos}" />
                <Label Grid.Row="0" Grid.Column="3" Style="{StaticResource pedTotal}"
                       Text="{Binding BindingContext.Pedidos.Count, Source={x:Reference this}}" />

                <Label Grid.Row="0" Grid.Column="5" Style="{StaticResource pedTotal}"
                       Text="{translator:Translate PedidoTela_PedidoVC_QtdTotalItens}" />
                <!-- Com itens filtrados o valor desloca para alinhar com a 2ª linha (PegadaIOS: x 473 / 795, senão 400 / 690) -->
                <Label Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="2" Style="{StaticResource pedTotal}"
                       Text="{Binding BindingContext.QtdTotalPedidos, Source={x:Reference this}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Value="True"
                                     Binding="{Binding BindingContext.TotaisFiltradosVisiveis, Source={x:Reference this}}">
                            <Setter Property="Margin" Value="73,0,0,0" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Label Grid.Row="0" Grid.Column="8" Style="{StaticResource pedTotal}"
                       Text="{translator:Translate PedidoTela_PedidoVC_ValorTotal}" />
                <Label Grid.Row="0" Grid.Column="9" Style="{StaticResource pedTotal}"
                       Text="{Binding BindingContext.ValorTotalPedidos, Source={x:Reference this}, Converter={StaticResource ValorParaMoeda}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Value="True"
                                     Binding="{Binding BindingContext.TotaisFiltradosVisiveis, Source={x:Reference this}}">
                            <Setter Property="Margin" Value="105,0,0,0" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <!-- Totais dos itens filtrados (aparecem só quando há filtro de situação, nível de produto ou referência) -->
                <Label Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" Style="{StaticResource pedTotal}"
                       IsVisible="{Binding BindingContext.TotaisFiltradosVisiveis, Source={x:Reference this}}"
                       Text="{translator:Translate PedidoTela_PedidoVC_QtdTotalItensFiltrados}" />
                <Label Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2" Style="{StaticResource pedTotal}" Margin="70,0,0,0"
                       IsVisible="{Binding BindingContext.TotaisFiltradosVisiveis, Source={x:Reference this}}"
                       Text="{Binding BindingContext.QtdTotalItensFiltrados, Source={x:Reference this}}" />
                <Label Grid.Row="1" Grid.Column="8" Grid.ColumnSpan="2" Style="{StaticResource pedTotal}"
                       IsVisible="{Binding BindingContext.TotaisFiltradosVisiveis, Source={x:Reference this}}"
                       Text="{translator:Translate PedidoTela_PedidoVC_ValorTotalItensFiltrados}" />
                <Label Grid.Row="1" Grid.Column="9" Style="{StaticResource pedTotal}" Margin="105,0,0,0"
                       IsVisible="{Binding BindingContext.TotaisFiltradosVisiveis, Source={x:Reference this}}"
                       Text="{Binding BindingContext.ValorTotalItensFiltrados, Source={x:Reference this}, Converter={StaticResource ValorParaMoeda}}" />
            </Grid>

            <!-- ============ ITENS DO PEDIDO (Zzv-4n-Rp6 / ItemPedidoTableViewController) ============ -->
            <Grid Grid.Row="4" RowSpacing="0" ColumnSpacing="0" BackgroundColor="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="109" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Grid.Row="0" ColumnSpacing="0" RowSpacing="0" BackgroundColor="#D9D9D9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34*" />
                        <ColumnDefinition Width="60*" />
                        <ColumnDefinition Width="171*" />
                        <ColumnDefinition Width="76*" />
                        <ColumnDefinition Width="61*" />
                        <ColumnDefinition Width="61*" />
                        <ColumnDefinition Width="61*" />
                        <ColumnDefinition Width="31*" />
                        <ColumnDefinition Width="41*" />
                        <ColumnDefinition Width="41*" />
