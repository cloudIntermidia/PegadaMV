<ContentView xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             xmlns:custom="clr-namespace:MobiliVendas.Core.CustomView.Controls;assembly=MobiliVendas.Core"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
             xmlns:translator="clr-namespace:MobiliVendas.Core.Helpers;assembly=MobiliVendas.Core"
             x:Class="Pegada.Core.Views.Shared.NovoAtendimentoView"
             x:Name="this">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Modelo local (não usa o ClienteSelecaoTemplate global de App.xaml, para não afetar a tela
                 de Seleção de Cliente): checkbox à esquerda (btnCheckCliente, EdicaoAtendimentoTableViewCell)
                 + Código Cliente numa coluna própria com largura fixa (para não truncar, como cliente.code em
                 SelecaoClienteViewController/EdicaoAtendimentoViewController) + linha de Endereço
                 (enderecoClienteLabel, também presente nas duas telas do PegadaIOS e que faltava aqui). -->
            <DataTemplate x:Key="ClienteAtendimentoCheckTemplate">
                <ViewCell>
                    <StackLayout>
                        <Grid Margin="1"
                              RowSpacing="0"
                              HeightRequest="90">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="25" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ffimageloading:CachedImage Grid.Row="0"
                                                         Grid.Column="0"
                                                         Grid.RowSpan="3"
                                                         BackgroundColor="Transparent"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         HeightRequest="26"
                                                         Aspect="AspectFit"
                                                         IsVisible="{Binding BindingContext.ModoAtualizacaoCadastro, Source={x:Reference this}}"
                                                         Source="{Binding UiChecked, Converter={StaticResource BoleanoParaImagem}}">
                                <ffimageloading:CachedImage.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.MarcarClienteCommand, Source={x:Reference this}}" CommandParameter="{Binding .}"/>
                                </ffimageloading:CachedImage.GestureRecognizers>
                            </ffimageloading:CachedImage>

                            <Label Grid.Row="0" Grid.Column="1"
                                   LineBreakMode="TailTruncation"
                                   FontFamily="{StaticResource RobotoNormalFont}"
                                   Text="{Binding Apelido}"
                                   TextColor="{Binding ClienteLiberadoParaVenda, Converter={StaticResource BoleanoParaCor}, ConverterParameter='Black,Red'}"
                                   FontSize="14"/>
                            <Label Grid.Row="0" Grid.Column="2"
                                   LineBreakMode="NoWrap"
                                   FontFamily="{StaticResource RobotoNormalFont}"
                                   Text="{Binding CodPessoaCliente}"
                                   TextColor="{Binding ClienteLiberadoParaVenda, Converter={StaticResource BoleanoParaCor}, ConverterParameter='Black,Red'}"
                                   FontSize="14"
                                   HorizontalTextAlignment="End"
                                   HorizontalOptions="Fill"/>

                            <ffimageloading:CachedImage Grid.Row="0"
                                                         Grid.Column="3"
                                                         Grid.RowSpan="3"
                                                         BackgroundColor="Transparent"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         HeightRequest="35"
                                                         Aspect="AspectFit"
                                                         Source="info.png">
                                <ffimageloading:CachedImage.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding InfoCommand}" CommandParameter="{Binding .}"/>
                                </ffimageloading:CachedImage.GestureRecognizers>
                            </ffimageloading:CachedImage>

                            <Label Grid.Row="1" Grid.Column="1"
                                   LineBreakMode="TailTruncation"
                                   FontFamily="{StaticResource RobotoNormalFont}"
                                   Text="{Binding NomeFantasia}"
                                   TextColor="{Binding ClienteLiberadoParaVenda, Converter={StaticResource BoleanoParaCor}, ConverterParameter='#666666,Red'}"
                                   FontSize="12"/>

                            <Label Grid.Row="1" Grid.Column="2"
                                   LineBreakMode="NoWrap"
                                   FontFamily="{StaticResource RobotoNormalFont}"
                                   Text="{Binding Localidade}"
                                   TextColor="{Binding ClienteLiberadoParaVenda, Converter={StaticResource BoleanoParaCor}, ConverterParameter='#666666,Red'}"
                                   FontSize="12"
                                   HorizontalTextAlignment="End"
                                   HorizontalOptions="Fill"/>

                            <!-- Equivalente a enderecoClienteLabel (SelecaoClienteViewController /
                                 EdicaoAtendimentoViewController, PegadaIOS) - faltava nesta tela. -->
                            <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                   LineBreakMode="TailTruncation"
                                   FontFamily="{StaticResource RobotoNormalFont}"
                                   Text="{Binding EnderecoPrincipalCompleto}"
                                   TextColor="Gray"
                                   FontSize="11"/>

                        </Grid>

                        <BoxView HeightRequest="0.5"
                                 HorizontalOptions="FillAndExpand"
                                 Color="Black"/>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>

            <!-- Célula de GrupoCliente de -tableView:cellForRowAtIndexPath: (EdicaoAtendimentoViewController, PegadaIOS):
                 "Descrição - Código - N cliente(s) - N bloqueado(s)" em vermelho quando há bloqueados, código à
                 direita e checkbox só no modo "Atualizar Cadastro"; sem botão de info. -->
            <DataTemplate x:Key="GrupoAtendimentoCheckTemplate">
                <ViewCell>
                    <StackLayout Spacing="0">
                        <Grid Margin="1"
                              HeightRequest="49">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <ffimageloading:CachedImage Grid.Column="0"
                                                         BackgroundColor="Transparent"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         HeightRequest="26"
                                                         Aspect="AspectFit"
                                                         IsVisible="{Binding BindingContext.ModoAtualizacaoCadastro, Source={x:Reference this}}"
                                                         Source="{Binding UiChecked, Converter={StaticResource BoleanoParaImagem}}">
                                <ffimageloading:CachedImage.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.MarcarGrupoCommand, Source={x:Reference this}}" CommandParameter="{Binding .}"/>
                                </ffimageloading:CachedImage.GestureRecognizers>
                            </ffimageloading:CachedImage>

                            <Label Grid.Column="1"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"
                                   FontFamily="{StaticResource RobotoNormalFont}"
                                   Text="{Binding TituloGrupo}"
                                   TextColor="{Binding PossuiBloqueados, Converter={StaticResource BoleanoParaCor}, ConverterParameter='Red,Black'}"
                                   FontSize="14"/>

                            <Label Grid.Column="2"
                                   VerticalOptions="Center"
                                   LineBreakMode="NoWrap"
                                   FontFamily="{StaticResource RobotoNormalFont}"
                                   Text="{Binding CodGrupoCliente}"
                                   TextColor="{Binding PossuiBloqueados, Converter={StaticResource BoleanoParaCor}, ConverterParameter='Red,Black'}"
                                   FontSize="14"
                                   HorizontalTextAlignment="End"
                                   HorizontalOptions="Fill"/>
                        </Grid>

                        <BoxView HeightRequest="0.5"
                                 HorizontalOptions="FillAndExpand"
                                 Color="Black"/>
                    </StackLayout>
                </ViewCell>
            </DataTemplate>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- FUNDO ESCURO -->
    <Grid BackgroundColor="#80000000">

        <!-- CARD CENTRAL -->
        <Frame BackgroundColor="LightGray"
               CornerRadius="15"
               Padding="0"
               HasShadow="False"
               BorderColor="#DADADA"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="900"
               HeightRequest="750">

            <Grid RowSpacing="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Padding="15,10" BackgroundColor="#FAFAFA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button 
                            FontFamily="{StaticResource RobotoNormalFont}" 
                            Text="{translator:Translate CarrinhoBtnCancelar}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource corButtonBackPopover}"
                            HorizontalOptions="Start"
                            Command="{Binding BindingContext.CancelarAtendimentoCommand, Source={x:Reference this}}"/>

                    <Label Grid.Column="1"
                           Margin="0,10,0,0"
                           Text="{translator:Translate EdicaoAtendimentoTitulo}"
                           HorizontalOptions="Center"
                           FontAttributes="Bold"/>

                    <Button Grid.Column="2" 
                            FontFamily="{StaticResource RobotoNormalFont}" 
                            Text="{translator:Translate GlobalBtnSalvar}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource corButtonBackPopover}"
                            HorizontalOptions="End"
                            Command="{Binding BindingContext.SalvarAtendimentoCommand, Source={x:Reference this}}"/>
                </Grid>

                <!-- CONTEÚDO -->
                <Grid Grid.Row="1" Padding="15" RowSpacing="8">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Preposto -->
                        <RowDefinition Height="Auto"/>  <!-- Cliente/Grupo -->
                        <RowDefinition Height="Auto"/>  <!-- Filtros -->
                        <RowDefinition Height="Auto"/>  <!-- Busca -->
                        <RowDefinition Height="*"/>     <!-- Lista -->
                        <RowDefinition Height="Auto"/>  <!-- tabela de preço -->
                    </Grid.RowDefinitions>

                  <custom:BotaoComVisualDropView
                      Grid.Row="0"
                            Label="{translator:Translate EdicaoAtendimentoLblPreposto}"
                            WidthRequest="500"
                            HeightRequest="60"
                            HorizontalOptions="Center"
                            Command="{Binding BindingContext.SelecionarPrepostoCommand, Source={x:Reference this}}"
                            Descricao="{Binding BindingContext.PrepostoSelecionado.Nome,Source={x:Reference this}}"/>

                    <Frame Grid.Row="1"
                        CornerRadius="10"
                           Padding="2"
                           HasShadow="False"
                           BorderColor="#DCDCDC"
                           BackgroundColor="#EAEAEA"
                           HorizontalOptions="Center"
                           WidthRequest="300">

                        <!-- clienteGrupoSegmentedControl (EdicaoAtendimentoViewController, PegadaIOS): o segmento
                             selecionado fica em branco/negrito; tocar no outro troca a lista entre clientes e grupos. -->
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CLIENTE -->
                            <Frame Grid.Column="0"
                                   CornerRadius="8"
                                   Padding="5"
                                   HasShadow="False"
                                   BackgroundColor="White">
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame" Binding="{Binding BindingContext.IsModoGrupo, Source={x:Reference this}}" Value="True">
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                    </DataTrigger>
                                </Frame.Triggers>
                                <Label Text="{translator:Translate EdicaoAtendimentoLblCliente}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontAttributes="Bold"
                                       TextColor="Black">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding BindingContext.IsModoGrupo, Source={x:Reference this}}" Value="True">
                                            <Setter Property="FontAttributes" Value="None"/>
                                            <Setter Property="TextColor" Value="Gray"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.SelecionarTipoAtendimentoCommand, Source={x:Reference this}}" CommandParameter="1"/>
                                </Frame.GestureRecognizers>
                            </Frame>

                            <!-- GRUPO -->
                            <Frame Grid.Column="1"
                                   CornerRadius="8"
                                   Padding="5"
                                   HasShadow="False"
                                   BackgroundColor="Transparent">
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame" Binding="{Binding BindingContext.IsModoGrupo, Source={x:Reference this}}" Value="True">
                                        <Setter Property="BackgroundColor" Value="White"/>
                                    </DataTrigger>
                                </Frame.Triggers>
                                <Label Text="{translator:Translate SelecaoClienteHeaderGrupo}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="Gray">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding BindingContext.IsModoGrupo, Source={x:Reference this}}" Value="True">
                                            <Setter Property="FontAttributes" Value="Bold"/>
                                            <Setter Property="TextColor" Value="Black"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.SelecionarTipoAtendimentoCommand, Source={x:Reference this}}" CommandParameter="2"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </Grid>

                    </Frame>

                    <!-- FILTROS (só para a lista de clientes: os grupos do iOS não usam esses filtros) -->
                    <Grid Grid.Row="2" ColumnSpacing="5"
                          IsEnabled="{Binding BindingContext.IsModoGrupo, Source={x:Reference this}, Converter={StaticResource InverterValoresParaBoleano}}">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding BindingContext.IsModoGrupo, Source={x:Reference this}}" Value="True">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Grid.Triggers>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                             <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Frame CornerRadius="5"
                               Grid.Column="0"
                               Padding="6"
                               HeightRequest="35"
                               HasShadow="False"
                               BorderColor="#E0E0E0"
                               BackgroundColor="#F7F7F7"
                               HorizontalOptions="FillAndExpand">

                             <StackLayout Spacing="2" Orientation="Vertical" VerticalOptions="CenterAndExpand">

                                <Label Text="{translator:Translate SelecaoClienteHeaderUF}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="13"/>

                                <Label Text="{Binding BindingContext.UfSelecionada.Descricao, Source={x:Reference this}}"
                                       HorizontalTextAlignment="Center"
                                       FontSize="12"/>
                             </StackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding BindingContext.FiltroUFCommand, Source={x:Reference this}}"/>
                            </Frame.GestureRecognizers>

                        </Frame>

                        <Frame CornerRadius="5"
                                Grid.Column="1"
                               Padding="6"
                               HeightRequest="35"
                               HasShadow="False"
                               BorderColor="#E0E0E0"
                               BackgroundColor="#F7F7F7"
                               HorizontalOptions="FillAndExpand">

                             <StackLayout Spacing="2" Orientation="Vertical" VerticalOptions="CenterAndExpand">

                                <Label Text="{translator:Translate SelecaoClienteHeaderCidade}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="13"/>

                                <Label Text="{Binding BindingContext.CidadeSelecionada.Descricao, Source={x:Reference this}}"
                                       HorizontalTextAlignment="Center"
                                       FontSize="12"/>
                             </StackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding BindingContext.FiltroCidadeCommand, Source={x:Reference this}}"/>
                            </Frame.GestureRecognizers>

                        </Frame>

                        <Frame CornerRadius="5"
                                Grid.Column="2"
                               Padding="6"
                               HeightRequest="35"
                               HasShadow="False"
                               BorderColor="#E0E0E0"
                               BackgroundColor="#F7F7F7"
                               HorizontalOptions="FillAndExpand">

                             <StackLayout Spacing="2" Orientation="Vertical" VerticalOptions="CenterAndExpand">

                                <Label Text="{translator:Translate CarrinhoHeaderSituacao}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="13"/>

                                <Label Text="{Binding BindingContext.SituacaoSelecionada.Descricao, Source={x:Reference this}}"
                                       HorizontalTextAlignment="Center"
                                       FontSize="12"/>
                             </StackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding BindingContext.FiltroSituacaoCommand, Source={x:Reference this}}"/>
                            </Frame.GestureRecognizers>

                        </Frame>

                        <Frame CornerRadius="5"
                                Grid.Column="3"
                               Padding="6"
                               HeightRequest="35"
                               HasShadow="False"
                               BorderColor="#E0E0E0"
                               BackgroundColor="#F7F7F7"
                               HorizontalOptions="FillAndExpand">

                             <StackLayout Spacing="2" Orientation="Vertical" VerticalOptions="CenterAndExpand">

                                <Label Text="{translator:Translate SelecaoClienteHeaderClasseRisco}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="13"/>

                                <Label Text="{Binding BindingContext.ClasseRiscoSelecionada.Descricao, Source={x:Reference this}}"
                                       HorizontalTextAlignment="Center"
                                       FontSize="12"/>
                             </StackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding BindingContext.FiltroClasseRiscoCommand, Source={x:Reference this}}"/>
                            </Frame.GestureRecognizers>

                        </Frame>

                        <Frame CornerRadius="5"
                                Grid.Column="4"
                               Padding="6"
                               HeightRequest="35"
                               HasShadow="False"
                               BorderColor="#E0E0E0"
                               BackgroundColor="#F7F7F7"
                               HorizontalOptions="FillAndExpand">

                             <StackLayout Spacing="2" Orientation="Vertical" VerticalOptions="CenterAndExpand">

                                <Label Text="{translator:Translate SelecaoClienteHeaderStatus}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="13"/>

                                <Label Text="{Binding BindingContext.StatusSelecionado.Descricao, Source={x:Reference this}}"
                                       HorizontalTextAlignment="Center"
                                        FontSize="12"/>
                             </StackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding BindingContext.FiltroStatusCommand, Source={x:Reference this}}"/>
                            </Frame.GestureRecognizers>

                        </Frame>

                         <ffimageloading:CachedImage Grid.Column="5" BackgroundColor="Transparent"
                                            Source="pesquisa_icone_preco.png" 
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            Margin="0,0,0,0"
                                            Aspect="AspectFit">
                        <ffimageloading:CachedImage.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.PesquisarClienteCommand, Source={x:Reference this}}"/>
                        </ffimageloading:CachedImage.GestureRecognizers>
                    </ffimageloading:CachedImage>

                    </Grid>

                    <!-- BUSCA -->
                    <Frame  Grid.Row="3"
                               CornerRadius="5" Padding="5"
                               HasShadow="False"
                               BorderColor="#DCDCDC"
                               BackgroundColor="#F7F7F7">

                        <Entry Placeholder="{Binding BindingContext.PlaceholderPesquisa, Source={x:Reference this}}"
                               x:Name="SearchBarCliente"
                               Text="{Binding BindingContext.FiltroPesquisa, Source={x:Reference this}}"
                               BackgroundColor="Transparent"/>
                    </Frame>

                    <syncfusion:SfListView Grid.Row="4"
                            VerticalOptions="FillAndExpand"
                            BackgroundColor="White"
                            ItemsSource="{Binding BindingContext.Clientes, Source={x:Reference this}}"
                            ItemTemplate="{StaticResource ClienteAtendimentoCheckTemplate}"
                            ItemSize="70"
                            ItemSpacing="1"
                            SelectionBackgroundColor="LightGray"
                            TapCommand="{Binding BindingContext.SelecionarClienteCommand, Source={x:Reference this}}"  
                            IsVisible="{Binding BindingContext.IsModoGrupo, Source={x:Reference this}, Converter={StaticResource InverterValoresParaBoleano}}"
                            >
                    </syncfusion:SfListView>

                    <!-- Lista de grupos (segmento "Grupo"): mesma posição da lista de clientes. -->
                    <syncfusion:SfListView Grid.Row="4"
                            VerticalOptions="FillAndExpand"
                            BackgroundColor="White"
                            ItemsSource="{Binding BindingContext.Grupos, Source={x:Reference this}}"
                            ItemTemplate="{StaticResource GrupoAtendimentoCheckTemplate}"
                            ItemSize="50"
                            ItemSpacing="1"
                            SelectionBackgroundColor="LightGray"
                            TapCommand="{Binding BindingContext.SelecionarGrupoCommand, Source={x:Reference this}}"
                            IsVisible="{Binding BindingContext.IsModoGrupo, Source={x:Reference this}}">
                    </syncfusion:SfListView>

                    <custom:BotaoComVisualDropView Label="{translator:Translate CatalogoTabelaPreco}" Grid.Row="5"
                                                   WidthRequest="500"
                                                   HeightRequest="50"
                                                   HorizontalOptions="Center"
                                                   Command="{Binding BindingContext.SelecionarTabelaPrecoCommand, Source={x:Reference this}}"
                                                   Descricao="{Binding BindingContext.CarrinhoFechamento.TabelaPreco, Source={x:Reference this}}"
                                                       />

                </Grid>

                <!-- RODAPÉ -->
                <Grid Grid.Row="2" Padding="5"  BackgroundColor="#FAFAFA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Text="{Binding BindingContext.TextoBotaoAtualizarCadastro, Source={x:Reference this}}"
                           TextColor="#007AFF"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.AtualizarCadastroCommand, Source={x:Reference this}}"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Grid.Column="1"
                           Text="{Binding BindingContext.TextoBotaoTransmitir, Source={x:Reference this}}"
                           TextColor="#007AFF"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.TransmitirClienteCommand, Source={x:Reference this}}"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Grid.Column="2"
                           Text="{translator:Translate SelecaoClienteBtnNovoCliente}"
                           TextColor="#007AFF"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.NovoClienteCommand, Source={x:Reference this}}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

            </Grid>

        </Frame>

    </Grid>

</ContentView>