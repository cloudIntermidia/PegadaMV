<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pegada.Core.Views.Carrinho.EdicaoGradeItemView"
             x:Name="this">

    <!--
        Espelha a cena EdicaoGradeItemCarrinho do PegadaIOS (830x316): barra "Cancelar / Alteração de Grade / Salvar",
        descrição, valor, tamanhos de corrugado, quadro Cxs/Total e a grade com "+", numeração, quantidade e "-"
        (colunas de 71 pt).
    -->
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="gradeCabecalho" TargetType="Label">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="#808080" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="gradeValor" TargetType="Label">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="BackgroundColor" Value="#D9D9D9" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="gradeBotao" TargetType="Button">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextColor" Value="#007AFF" />
                <Setter Property="BackgroundColor" Value="#EDEDED" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <ContentView.Content>
        <AbsoluteLayout>

            <!-- FUNDO ESCURO -->
            <AbsoluteLayout BackgroundColor="#000" Opacity="0.3"
                            AbsoluteLayout.LayoutBounds="0,0,1,1"
                            AbsoluteLayout.LayoutFlags="All" />

            <Frame AbsoluteLayout.LayoutBounds="0.5,0.5,830,316"
                   AbsoluteLayout.LayoutFlags="PositionProportional"
                   Padding="0" HasShadow="True" CornerRadius="10" IsClippedToBounds="True"
                   BackgroundColor="White">

                <AbsoluteLayout>

                    <!-- Barra de navegação -->
                    <BoxView AbsoluteLayout.LayoutBounds="0,0,830,44" BackgroundColor="#E1E3E6" />
                    <Label AbsoluteLayout.LayoutBounds="10,7,156,30" Text="Cancelar" FontSize="17" TextColor="#007AFF"
                           VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.CancelarCommand, Source={x:Reference this}}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label AbsoluteLayout.LayoutBounds="200,7,430,30" Text="Alteração de Grade" FontSize="17" TextColor="Black"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Label AbsoluteLayout.LayoutBounds="664,7,156,30" Text="Salvar" FontSize="17" TextColor="#007AFF"
                           HorizontalTextAlignment="End" VerticalTextAlignment="Center" FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.SalvarCommand, Source={x:Reference this}}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Produto -->
                    <Label AbsoluteLayout.LayoutBounds="20,54,790,21" FontSize="17" TextColor="Black" LineBreakMode="TailTruncation"
                           Text="{Binding BindingContext.Descricao, Source={x:Reference this}}" />
                    <Label AbsoluteLayout.LayoutBounds="20,75,300,21" FontSize="17" TextColor="Black"
                           Text="{Binding BindingContext.ValorUnitario, Source={x:Reference this}}" />
                    <Label AbsoluteLayout.LayoutBounds="20,108,790,21" FontSize="17" TextColor="Black"
                           IsVisible="{Binding BindingContext.TamanhosVisivel, Source={x:Reference this}}"
                           Text="{Binding BindingContext.Tamanhos, Source={x:Reference this}}" />

                    <!-- Cxs / Total -->
                    <Label AbsoluteLayout.LayoutBounds="20,183,70,30" Text="Cxs" Style="{StaticResource gradeCabecalho}" />
                    <Label AbsoluteLayout.LayoutBounds="91,183,70,30" Text="Total" Style="{StaticResource gradeCabecalho}" />
                    <Label AbsoluteLayout.LayoutBounds="20,214,70,30" Style="{StaticResource gradeValor}"
                           Text="{Binding BindingContext.QtdCaixas, Source={x:Reference this}}" />
                    <Label AbsoluteLayout.LayoutBounds="91,214,70,30" Style="{StaticResource gradeValor}"
                           Text="{Binding BindingContext.QtdTotal, Source={x:Reference this}}" />

                    <!-- Grade -->
                    <ScrollView AbsoluteLayout.LayoutBounds="162,141,650,142" Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Always">
                        <StackLayout Orientation="Horizontal" Spacing="1" Padding="0,0,0,0"
                                     BindableLayout.ItemsSource="{Binding BindingContext.Linhas, Source={x:Reference this}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <AbsoluteLayout WidthRequest="70" HeightRequest="138">
                                        <Button AbsoluteLayout.LayoutBounds="5,5,60,35" Text="+" Style="{StaticResource gradeBotao}"
                                                Command="{Binding MaisCommand}" />
                                        <Label AbsoluteLayout.LayoutBounds="0,41,70,30" Style="{StaticResource gradeCabecalho}"
                                               FontAttributes="Bold" Text="{Binding Descricao}" />
                                        <Label AbsoluteLayout.LayoutBounds="0,72,70,30" Style="{StaticResource gradeValor}"
                                               Text="{Binding Qtd}" />
                                        <Button AbsoluteLayout.LayoutBounds="5,103,60,35" Text="-" Style="{StaticResource gradeBotao}"
                                                Command="{Binding MenosCommand}" />
                                    </AbsoluteLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </ScrollView>

                </AbsoluteLayout>
            </Frame>
        </AbsoluteLayout>
    </ContentView.Content>
</ContentView>
