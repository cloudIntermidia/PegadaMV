<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:MobiliVendas.Core.Views.Tablet.Shared;assembly=MobiliVendas.Core"
             xmlns:forms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
             xmlns:behaviors="clr-namespace:Prism.Behaviors;assembly=Prism.Forms"
             xmlns:controls="clr-namespace:Flex.Controls;assembly=Flex"
             xmlns:wrapLayout="clr-namespace:MobiliVendas.Core.CustomView.Layouts.WrapLayout;assembly=MobiliVendas.Core"
             xmlns:session="clr-namespace:MobiliVendas.Core;assembly=MobiliVendas.Core"
             xmlns:prism="clr-namespace:Prism.Mvvm;assembly=Prism.Forms"
             xmlns:translator="clr-namespace:MobiliVendas.Core.Helpers;assembly=MobiliVendas.Core"
             prism:ViewModelLocator.AutowireViewModel="True"
             x:Class="Pegada.Core.Views.Carrinho.CarrinhoPage"
             x:Name="this">
    <AbsoluteLayout BackgroundColor="White">

        <StackLayout AbsoluteLayout.LayoutBounds="0,0,1,0.9"
                AbsoluteLayout.LayoutFlags="All">

            <shared:CabecalhoView x:Name="cabecalho"/>

            <!--INICIO Grid de Pedidos -->
            <Grid ColumnSpacing="1" 
                  RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.5*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />


                </Grid.ColumnDefinitions>


                <!--Header-->
                <StackLayout Grid.Row="0"
                             Grid.Column="0" 
                             BackgroundColor="{StaticResource corHeaderGrid}"
                             VerticalOptions="FillAndExpand">

                    <forms:CachedImage Aspect="AspectFit"
                                       HeightRequest="25"
                                       VerticalOptions="CenterAndExpand"
                                       HorizontalOptions="Center"
                                       Source="{Binding TodosCarrinhosChecados, Converter={StaticResource BoleanoParaImagem}}">
                        <forms:CachedImage.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Path=BindingContext.MarcarCarrinhosCommand, Source={x:Reference Name=this}}"/>
                        </forms:CachedImage.GestureRecognizers>
                    </forms:CachedImage>
                </StackLayout>


                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderPedidoAFV}"   Grid.Row="0" Grid.Column="1"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderPreposto}"      Grid.Row="0" Grid.Column="2"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderCliente}"      Grid.Row="0" Grid.Column="3"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderCondPagto}"   Grid.Row="0" Grid.Column="4"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderTipo}"  Grid.Row="0" Grid.Column="5"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderSituacao}"  Grid.Row="0" Grid.Column="6"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderFaturamento}"  Grid.Row="0" Grid.Column="7"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderQtd}"   Grid.Row="0" Grid.Column="8"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderValorTotal}"     Grid.Row="0" Grid.Column="9"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderValorLiquido}"      Grid.Row="0" Grid.Column="10"/>

                <!--Header-->

                <ListView Grid.Row="1" 
                          Grid.Column="0" 
                          Grid.ColumnSpan="11"
                          HeightRequest="350"
                          SeparatorVisibility="Default"
                          ItemsSource="{Binding Pedidos}">

                    <ListView.Behaviors>
                        <behaviors:EventToCommandBehavior EventName="ItemTapped" 
                                                  Command="{Binding PedidoTappedCommand}"
                                                  EventArgsParameterPath="Item" />
                    </ListView.Behaviors>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <!-- Transparente (não White) quando liberado, para o cinza da seleção da linha aparecer
                                     inteiro, igual à lista de itens. -->
                                <Grid BackgroundColor="{Binding IndBloqueado, Converter={StaticResource BoleanoParaCor},ConverterParameter='Red,Transparent'}"
                                      VerticalOptions="Center"
                                      HeightRequest="30">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.5*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>

                                    <StackLayout Grid.Row="0" Grid.Column="0" 
                                                 BackgroundColor="Transparent"
                                                 VerticalOptions="FillAndExpand">

                                        <forms:CachedImage Aspect="AspectFit"
                                                           HeightRequest="25"
                                                           VerticalOptions="CenterAndExpand"
                                                           HorizontalOptions="Center"
                                                           Source="{Binding CarrinhoChecado, Converter={StaticResource BoleanoParaImagem}}">
                                            <forms:CachedImage.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Path=BindingContext.MarcarCarrinhoCommand, Source={x:Reference Name=this}}" CommandParameter="{Binding .}"/>
                                            </forms:CachedImage.GestureRecognizers>
                                        </forms:CachedImage>
                                    </StackLayout>



                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding CodCarrinho}" Grid.Row="0" Grid.Column="1" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding Preposto}"  Grid.Row="0" Grid.Column="2"/>
                                    <Label Style="{StaticResource labelGridItem}" FontSize="10"
                                           Grid.Row="0" Grid.Column="3">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding RazaoSocial}" />
                                                <Span Text=" - " />
                                                <Span Text="{Binding CNPJ}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding CondicaoPagamento}"  Grid.Row="0" Grid.Column="4"/>
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding TipoPedido}" Grid.Row="0" Grid.Column="5" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding Situacao}" Grid.Row="0" Grid.Column="6" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding DataEntrega, StringFormat='{0:dd/MM/yyyy}'}" Grid.Row="0" Grid.Column="7" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding QtdTotal}" Grid.Row="0" Grid.Column="8" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding ValorTotal, Converter={StaticResource ValorParaMoeda}}" Grid.Row="0" Grid.Column="9" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding ValorTotalLiquido, Converter={StaticResource ValorParaMoeda}}" Grid.Row="0" Grid.Column="10" />

                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <!-- FIM Grid de Pedidos -->

            <!--INICIO GRID DE AÇÕES PEDIDO-->
            <Grid Padding="5"
                ColumnSpacing="11"
                HorizontalOptions="End"
                Margin="10,0"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:FlexButton
                            Grid.Row="0" Grid.Column="2"
                            Text="{translator:Translate CarrinhoBtnCancelar}"
                            ClickedCommand="{Binding CancelarCommand}"
                            Style="{StaticResource flexButtonAction}"/>

                <controls:FlexButton
                            Grid.Row="0" Grid.Column="3"
                            Text="{translator:Translate CarrinhoBtnImprimir}"
                            ClickedCommand="{Binding ImprimirCommand}"
                            Style="{StaticResource flexButtonAction}"/>

                <controls:FlexButton
                            Grid.Row="0" Grid.Column="4"
                            Text="{translator:Translate CarrinhoBtnCopiar}"
                            ClickedCommand="{Binding CopiarCommand}"
                            Style="{StaticResource flexButtonAction}"/>

                <!--<controls:FlexButton
                            Grid.Row="0" Grid.Column="3"
                            Text="BLOQUEAR/DESBLOQUEAR"
                            ClickedCommand="{Binding BloquearCommand}"
                            Style="{StaticResource flexButtonAction}"/>-->

                <!--<controls:FlexButton
                            Grid.Row="0" Grid.Column="4"
                            Text="AGRUPAR"
                            ClickedCommand="{Binding AgruparCommand}"
                            Style="{StaticResource flexButtonAction}"/>-->

                <controls:FlexButton
                            Grid.Row="0" Grid.Column="5"
                            Text="{translator:Translate CarrinhoBtnFinalizar}"
                            ClickedCommand="{Binding EditarCommand}"
                            Style="{StaticResource flexButtonAction}"/>

                <controls:FlexButton
                                Grid.Row="0" Grid.Column="6"
                                Text="{translator:Translate CarrinhoBtnTransmitir}"
                                ClickedCommand="{Binding TransmitirCommand}"
                                Style="{StaticResource flexButtonAction}"/>


            </Grid>
            <!--FIM GRID DE AÇÕES PEDIDO-->

            <!--Grid de itens-->
            <Grid ColumnSpacing="1" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35" />
                    <ColumnDefinition Width="35" />
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.6*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="0.6*"/>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.6*"/>
                    <ColumnDefinition Width="0.6*"/>
                    <!--<ColumnDefinition Width="60" />-->
                </Grid.ColumnDefinitions>


                <!--Header-->
                <StackLayout Grid.Row="0" Grid.Column="0"
                             BackgroundColor="{StaticResource corHeaderGrid}"
                             VerticalOptions="FillAndExpand"
                             >
                    <forms:CachedImage 
                                            Aspect="AspectFit"
                                            HeightRequest="25"
                                            VerticalOptions="CenterAndExpand"
                                            HorizontalOptions="Center"
                                            Source="{Binding TodosItensChecados, Converter={StaticResource BoleanoParaImagem}}">
                        <forms:CachedImage.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Path=BindingContext.MarcarItensCommand, Source={x:Reference Name=this}}"/>
                        </forms:CachedImage.GestureRecognizers>
                    </forms:CachedImage>
                </StackLayout>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderItem}"             Grid.Row="0" Grid.Column="1"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderModelo}"        Grid.Row="0" Grid.Column="2" />
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderCategoria}"        Grid.Row="0" Grid.Column="3" />
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderDescricao}"        Grid.Row="0" Grid.Column="4" />

                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderDataDisp}"        Grid.Row="0" Grid.Column="5" />
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderCx}"        Grid.Row="0" Grid.Column="6" />
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderTotCx}"      Grid.Row="0" Grid.Column="7"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderMarkupCliente}"            Grid.Row="0" Grid.Column="8"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderMarkupAplicado}" Grid.Row="0" Grid.Column="9"/>
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderPreco}"      Grid.Row="0" Grid.Column="10" />
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderDescTotal}"      Grid.Row="0" Grid.Column="11" />
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderPrecoLiq}"      Grid.Row="0" Grid.Column="12" />
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoHeaderValorTotal}"      Grid.Row="0" Grid.Column="13" />
                <Label Style="{StaticResource labelGridHeader}" Text="{translator:Translate CarrinhoItemHeaderValorTotLiq}"      Grid.Row="0" Grid.Column="14" />
                <!--<Label Style="{StaticResource labelGridHeader}" Text="Foto"             Grid.Row="0" Grid.Column="15"/>-->
                <!--Header-->


                <ListView Grid.Row="1" 
                          Grid.Column="0" 
                          Grid.ColumnSpan="15"
                          HeightRequest="350"
                          SeparatorVisibility="Default"
                          ItemsSource="{Binding PedidoSelecionado.Itens}">

                    <ListView.Behaviors>
                        <behaviors:EventToCommandBehavior EventName="ItemTapped" 
                                                  Command="{Binding ItemTappedCommand}"
                                                  EventArgsParameterPath="Item" />
                    </ListView.Behaviors>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid VerticalOptions="Center" Padding="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="0.6*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="0.6*"/>
                                        <ColumnDefinition Width="0.4*"/>
                                        <ColumnDefinition Width="0.4*"/>
                                        <ColumnDefinition Width="0.4*"/>
                                        <ColumnDefinition Width="0.4*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="0.6*"/>
                                        <ColumnDefinition Width="0.6*"/>

                                    </Grid.ColumnDefinitions>

                                    <StackLayout Grid.Row="0"
                                                 Grid.Column="0" 
                                                 BackgroundColor="Transparent"
                                                 VerticalOptions="FillAndExpand">
                                        <forms:CachedImage 
                                                Aspect="AspectFit"
                                                HeightRequest="25"
                                                VerticalOptions="CenterAndExpand"
                                                HorizontalOptions="Center"
                                                Source="{Binding ItemChecado, Converter={StaticResource BoleanoParaImagem}}">
                                            <forms:CachedImage.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Path=BindingContext.MarcarItemCommand, Source={x:Reference Name=this}}" CommandParameter="{Binding .}"/>
                                            </forms:CachedImage.GestureRecognizers>
                                        </forms:CachedImage>
                                    </StackLayout>

                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding CodItemCarrinho}"                                                   Grid.Row="0" Grid.Column="1" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding CodModelo}"                                                   Grid.Row="0" Grid.Column="2" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding Categoria}"                                                   Grid.Row="0" Grid.Column="3" />

                                    <StackLayout                                                                                                                      Grid.Row="0" Grid.Column="4" >
                                        <Label Style="{StaticResource labelGridItem}" HorizontalTextAlignment="Start"  Text="{Binding Descricao}"/>
                                    </StackLayout>

                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding DataDisponivel}"                                                          Grid.Row="0" Grid.Column="5" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding QtdCaixa}"                                                          Grid.Row="0" Grid.Column="6" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding QtdTotalNaCaixa}"                                                          Grid.Row="0" Grid.Column="7" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding MarkupCliente}"                                                          Grid.Row="0" Grid.Column="8" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding MarkupAplicado}"                                                          Grid.Row="0" Grid.Column="9" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding PrecoCusto,  Converter={StaticResource ValorParaMoeda}}"             Grid.Row="0" Grid.Column="10" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding DescontoUI}"                                                          Grid.Row="0" Grid.Column="11" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding PrecoCustoComDesconto, Converter={StaticResource ValorParaMoeda}}"  Grid.Row="0" Grid.Column="12" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding ValorTotal, Converter={StaticResource ValorParaMoeda}}"             Grid.Row="0" Grid.Column="13" />
                                    <Label Style="{StaticResource labelGridItem}" Text="{Binding ValorTotalLiquido, Converter={StaticResource ValorParaMoeda}}"             Grid.Row="0" Grid.Column="14" />

                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>

            <!--ACOES SOBRE OS ITENS / GRADE-->
           <Grid ColumnSpacing="20"
                  Padding="20,5"
                  BackgroundColor="Transparent">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Botões -->
                    <ColumnDefinition Width="*"/>      <!-- Grade -->
                    <ColumnDefinition Width="200"/>    <!-- Imagem -->
                </Grid.ColumnDefinitions>


                <!-- ================= BOTÕES ================= -->
                <StackLayout Grid.Column="0"
                      VerticalOptions="End"
                      Spacing="10"
                      Margin="0,0,20,0">

                    <!-- Menu do item do PegadaIOS (longPressItemCarrinho / didSelectItemCarrinhoMenuOption).
                         Linha de cima: opções de um item, só depois de tocar/marcar um item que as libere
                         ("Editar preço líquido" ainda depende do cliente com PermiteAjustePreco). -->
                    <StackLayout Orientation="Horizontal" Spacing="6">
                        <controls:FlexButton
                            Text="{translator:Translate CarrinhoBtnEditarPrecoLiq}"
                            ClickedCommand="{Binding EditarPrecoItemCommand}"
                            Style="{StaticResource flexButtonAction}"
                            IsVisible="{Binding MostraEditarPrecoItem}" />

                        <controls:FlexButton
                            Text="{translator:Translate CarrinhoBtnVisualizarDesconto}"
                            ClickedCommand="{Binding VisualizarDescontoItemCommand}"
                            Style="{StaticResource flexButtonAction}"
                            IsVisible="{Binding MostraAcoesItemUnico}" />

                        <controls:FlexButton
                            Text="{translator:Translate CarrinhoBtnEditarLoja}"
                            ClickedCommand="{Binding EditarLojaItemCommand}"
                            Style="{StaticResource flexButtonAction}"
                            IsVisible="{Binding MostraAcoesItemUnico}" />
                    </StackLayout>

                    <!-- Linha de baixo: Excluir em qualquer item; Editar/Desmembrar fora da Pronta Entrega. -->
                    <StackLayout Orientation="Horizontal" Spacing="6">
                        <controls:FlexButton
                            Text="{translator:Translate CarrinhoBtnExcluir}"
                            ClickedCommand="{Binding ExcluirItemCommand}"
                            Style="{StaticResource flexButtonAction}" />

                        <controls:FlexButton
                            Text="{translator:Translate CarrinhoBtnEditar}"
                            ClickedCommand="{Binding EditarItemCommand}"
                            Style="{StaticResource flexButtonAction}"
                            IsVisible="{Binding PedidoSelecionado.NaoEProntaEntrega}" />

                        <controls:FlexButton
                            Text="{translator:Translate GlobalBtnDesmembrar}"
                            ClickedCommand="{Binding DesmembrarItemCommand}"
                            Style="{StaticResource flexButtonAction}"
                            IsVisible="{Binding PedidoSelecionado.NaoEProntaEntrega}" />
                    </StackLayout>
                </StackLayout>


                <!-- ================= GRADE ESTILO TABELA ================= -->
               <Grid Grid.Column="1"
                      HorizontalOptions="End"
                      VerticalOptions="End">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <!-- LINHA SUPERIOR (TAMANHOS) -->
                    <StackLayout Grid.Row="0"
                                 Orientation="Horizontal"
                                 HorizontalOptions="End"
                                 Spacing="0"
                                 BindableLayout.ItemsSource="{Binding ItemSelecionado.Grades}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="50"
                                      HeightRequest="30"
                                      BackgroundColor="#8E8E8E">

                                    <BoxView BackgroundColor="White"
                                             WidthRequest="1"
                                             HorizontalOptions="Start"/>

                                    <Label Text="{Binding CodDerivacao}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"
                                           TextColor="White"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>


                    <!-- LINHA INFERIOR (QUANTIDADES) -->
                    <StackLayout Grid.Row="1"
                                 Orientation="Horizontal"
                                 HorizontalOptions="End"
                                 Spacing="0"
                                 BindableLayout.ItemsSource="{Binding ItemSelecionado.Grades}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="50"
                                      HeightRequest="30"
                                      BackgroundColor="#F0F0F0">

                                    <BoxView BackgroundColor="#D0D0D0"
                                             WidthRequest="1"
                                             HorizontalOptions="Start"/>

                                    <Label Text="{Binding Qtd}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontSize="Medium"
                                           TextColor="#444"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>

                </Grid>


                <!-- ================= IMAGEM ================= -->
                <forms:CachedImage Grid.Column="2"
                                   WidthRequest="190"
                                   HeightRequest="170"
                                   Aspect="AspectFit"
                                   VerticalOptions="EndAndExpand"
                                   HorizontalOptions="End"
                                   DownsampleToViewSize="True"
                                   Source="{Binding ItemSelecionado.Imagem, Converter={StaticResource Base64ParaImagem}}" />

            </Grid>


        </StackLayout>


        <shared:NavegacaoBottomView x:Name="navegacao" PageValue="CARRINHO" AbsoluteLayout.LayoutBounds="0,1,1,0.08" AbsoluteLayout.LayoutFlags="All"/>

    </AbsoluteLayout>
</ContentPage>